  <msup data-latex="\\mathchoice{\\frac{\\mathrm{d} f}{\\mathrm{d} x}}{\\displaystyle{\\frac{\\mathrm{d} f}{\\mathrm{d} x}}}{\\scriptstyle{\\frac{\\mathrm{d} f}{\\mathrm{d} x}}}{\\scriptstyle{\\frac{\\mathrm{d} f}{\\mathrm{d} x}}}}">
