exports[`Esdiff diff order 1`] = `
"<math xmlns="http://www.w3.org/1998/Math/MathML" data-latex="\\diff[n]{f}{x}" display="block">
  <mfrac data-latex="\\frac{\\mathrm{d}^{n} f}{\\mathrm{d} x^{n}}">
    <mrow data-latex="\\mathrm{d}^{n} f">
      <msup data-latex="\\mathrm{d}^{n}">
        <mrow data-mjx-texclass="ORD" data-latex="\\mathrm{d}">
          <mi mathvariant="normal" data-latex="d">d</mi>
        </mrow>
        <mrow data-mjx-texclass="ORD" data-latex="{n}">
          <mi data-latex="n">n</mi>
        </mrow>
      </msup>
      <mi data-latex="f">f</mi>
    </mrow>
    <mrow data-latex="\\mathrm{d} x^{n}">
      <mrow data-mjx-texclass="ORD" data-latex="\\mathrm{d}">
        <mi mathvariant="normal" data-latex="d">d</mi>
      </mrow>
      <msup data-latex="x^{n}">
        <mi data-latex="x">x</mi>
        <mrow data-mjx-texclass="ORD" data-latex="{n}">
          <mi data-latex="n">n</mi>
        </mrow>
      </msup>
    </mrow>
  </mfrac>
</math>"
`;

