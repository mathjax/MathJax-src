      <mrow data-mjx-texclass="ORD" data-latex="\\scriptstyle{\\frac{\\mathrm{d} f}{\\mathrm{d} x}}">
        <mfrac data-latex="\\frac{\\mathrm{d} f}{\\mathrm{d} x}">
          <mrow data-latex="\\mathrm{d} f">
            <mrow data-mjx-texclass="ORD" data-latex="\\mathrm{d}">
              <mi mathvariant="normal" data-latex="d">d</mi>
            </mrow>
            <mi data-latex="f">f</mi>
          </mrow>
          <mrow data-latex="\\mathrm{d} x">
            <mrow data-mjx-texclass="ORD" data-latex="\\mathrm{d}">
              <mi mathvariant="normal" data-latex="d">d</mi>
            </mrow>
            <mi data-latex="x">x</mi>
          </mrow>
        </mfrac>
      </mrow>
    </mrow>
  </msup>
</math>"
`;

