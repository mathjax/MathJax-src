exports[`Thermodynamics Symbols Definition of \\cVpm 1`] = `
"<math xmlns="http://www.w3.org/1998/Math/MathML" data-latex="
      \\cVpm_i = \\Partial*{\\cVt}{\\Nt_i}{T,P,\\allNsbut{i}}
              = \\frac{\\partial}{\\partial\\Nt_i}
                   \\left[ -T\\PartialSecond{\\Ft}{T}{\\Vt,\\allNs}
                   \\right]_{T,P,\\allNsbut{i}}
    " display="block">
  <mspace width="0.111em" linebreak="nobreak" data-latex="\\mkern2mu"></mspace>
  <mover data-latex="\\overline{\\mkern-2mu{\\intensive{\\heatcapacitysymbol}}_{\\VolumeSymbol,i}\\mkern-1mu}">
    <mrow data-latex="\\mkern-2mu{\\intensive{\\heatcapacitysymbol}}_{\\VolumeSymbol,i}\\mkern-1mu">
      <mspace width="-0.111em" linebreak="nobreak" data-latex="\\mkern-2mu"></mspace>
