              </msup>
              <mrow data-mjx-texclass="ORD" data-latex="\\extensive{\\HelmholtzSymbol}">
                <mspace width="0.056em" linebreak="nobreak" data-latex="\\mkern1mu"></mspace>
                <munder data-latex="\\underline{\\mkern-1mu \\HelmholtzSymbol\\mkern-4mu}">
                  <mrow data-latex="\\mkern-1mu \\HelmholtzSymbol\\mkern-4mu">
                    <mspace width="-0.056em" linebreak="nobreak" data-latex="\\mkern-1mu"></mspace>
                    <mi data-latex="\\HelmholtzSymbol">A</mi>
                    <mspace width="-0.222em" linebreak="nobreak" data-latex="\\mkern-4mu"></mspace>
                  </mrow>
                  <mo accent="true">&#x2015;</mo>
                </munder>
                <mspace width="0.222em" linebreak="nobreak" data-latex="\\mkern4mu"></mspace>
              </mrow>
            </mrow>
            <mrow data-latex="\\partial T^2">
              <mi data-latex="\\partial">&#x2202;</mi>
              <msup data-latex="T^2">
                <mi data-latex="T">T</mi>
                <mn data-latex="2">2</mn>
              </msup>
            </mrow>
          </mfrac>
          <mo data-mjx-texclass="CLOSE" data-latex="\\right)">)</mo>
        </mrow>
        <mrow data-mjx-texclass="ORD" data-latex="{\\extensive{\\VolumeSymbol},\\allNs}">
          <mrow data-mjx-texclass="ORD" data-latex="\\extensive{\\VolumeSymbol}">
            <mspace width="0.056em" linebreak="nobreak" data-latex="\\mkern1mu"></mspace>
            <munder data-latex="\\underline{\\mkern-1mu \\VolumeSymbol\\mkern-4mu}">
              <mrow data-latex="\\mkern-1mu \\VolumeSymbol\\mkern-4mu">
                <mspace width="-0.056em" linebreak="nobreak" data-latex="\\mkern-1mu"></mspace>
                <mi data-latex="\\VolumeSymbol">V</mi>
                <mspace width="-0.222em" linebreak="nobreak" data-latex="\\mkern-4mu"></mspace>
              </mrow>
              <mo accent="true">&#x2015;</mo>
            </munder>
            <mspace width="0.222em" linebreak="nobreak" data-latex="\\mkern4mu"></mspace>
          </mrow>
          <mo data-latex=",">,</mo>
          <mrow data-mjx-texclass="ORD" data-latex="\\allNs">
            <mover>
              <mi data-latex="\\Nt">n</mi>
              <mo stretchy="false">&#x2192;</mo>
            </mover>
          </mrow>
        </mrow>
      </msub>
      <mo data-mjx-texclass="CLOSE" data-latex="\\right]">]</mo>
    </mrow>
    <mrow data-mjx-texclass="ORD" data-latex="{T,P,\\Nt_{j\\neq i}}">
