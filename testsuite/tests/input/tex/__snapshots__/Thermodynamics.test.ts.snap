      <mtr data-latex="\\left(\\frac{\\partial f_1}{\\partial x_1}\\right)_{x_{j\\neq1}}&amp;&amp;\\left(\\frac{\\partial f_1}{\\partial x_m}\\right)_{x_{j\\neq m}}">
        <mtd>
