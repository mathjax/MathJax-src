    <mi data-latex="i">i</mi>
  </msub>
  <mo data-latex="=">=</mo>
  <mn data-latex="1">1</mn>
  <mspace width="1em" data-latex="\\quad"></mspace>
  <mtext data-latex="\\text{or}">or</mtext>
  <mspace width="1em" data-latex="\\quad"></mspace>
  <msub data-latex="x_C">
    <mi data-latex="x">x</mi>
    <mi data-latex="C">C</mi>
  </msub>
  <mo data-latex="=">=</mo>
  <mn data-latex="1">1</mn>
  <mo data-latex="-">&#x2212;</mo>
  <munderover data-latex="\\sum_{i=1}^{\\ncomponents-1}">
    <mo data-latex="\\sum">&#x2211;</mo>
    <mrow data-mjx-texclass="ORD" data-latex="{i=1}">
      <mi data-latex="i">i</mi>
      <mo data-latex="=">=</mo>
      <mn data-latex="1">1</mn>
    </mrow>
    <mrow data-mjx-texclass="ORD" data-latex="{\\ncomponents-1}">
      <mi data-latex="\\ncomponents">C</mi>
      <mo data-latex="-">&#x2212;</mo>
      <mn data-latex="1">1</mn>
    </mrow>
  </munderover>
  <msub data-latex="x_i">
    <mi data-latex="x">x</mi>
    <mi data-latex="i">i</mi>
  </msub>
  <mspace width="1em" data-latex="\\quad"></mspace>
  <mtext data-latex="\\text{or}">or</mtext>
  <mspace width="1em" data-latex="\\quad"></mspace>
  <mrow data-mjx-texclass="ORD" data-latex="\\extensive{\\GibbsSymbol}">
    <mspace width="0.056em" linebreak="nobreak" data-latex="\\mkern1mu"></mspace>
    <munder data-latex="\\underline{\\mkern-1mu \\GibbsSymbol\\mkern-4mu}">
      <mrow data-latex="\\mkern-1mu \\GibbsSymbol\\mkern-4mu">
        <mspace width="-0.056em" linebreak="nobreak" data-latex="\\mkern-1mu"></mspace>
        <mi data-latex="\\GibbsSymbol">G</mi>
        <mspace width="-0.222em" linebreak="nobreak" data-latex="\\mkern-4mu"></mspace>
      </mrow>
      <mo accent="true">&#x2015;</mo>
    </munder>
    <mspace width="0.222em" linebreak="nobreak" data-latex="\\mkern4mu"></mspace>
  </mrow>
  <mo data-latex="=">=</mo>
  <munderover data-latex="\\sum_{j=1}^{\\ncomponents}">
    <mo data-latex="\\sum">&#x2211;</mo>
    <mrow data-mjx-texclass="ORD" data-latex="{j=1}">
      <mi data-latex="j">j</mi>
      <mo data-latex="=">=</mo>
