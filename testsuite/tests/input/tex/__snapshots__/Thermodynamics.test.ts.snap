exports[`Thermodynamics Partials \\Partial and \\Partial* 1`] = `
"<math xmlns="http://www.w3.org/1998/Math/MathML" data-latex="\\Partial{\\Hm}{T}{P} = \\cP \\qquad \\Partial*{\\Hm}{T}{P} = \\cP" display="block">
  <msub data-latex="\\left(\\frac{\\partial \\Hm}{\\partial T}\\right)_{P}">
    <mrow data-mjx-texclass="INNER" data-latex="\\left(\\frac{\\partial \\Hm}{\\partial T}\\right)">
      <mo data-mjx-texclass="OPEN" data-latex="\\left(">(</mo>
      <mfrac data-latex="\\frac{\\partial \\Hm}{\\partial T}">
        <mrow data-latex="\\partial \\Hm">
          <mi data-latex="\\partial">&#x2202;</mi>
          <mi data-latex="\\Hm">H</mi>
        </mrow>
        <mrow data-latex="\\partial T">
          <mi data-latex="\\partial">&#x2202;</mi>
          <mi data-latex="T">T</mi>
        </mrow>
      </mfrac>
      <mo data-mjx-texclass="CLOSE" data-latex="\\right)">)</mo>
    </mrow>
    <mrow data-mjx-texclass="ORD" data-latex="{P}">
      <mi data-latex="P">P</mi>
    </mrow>
  </msub>
  <mo data-latex="=">=</mo>
  <msub data-latex="\\intensive{\\heatcapacitysymbol}_{P}">
    <mi data-latex="\\intensive{\\heatcapacitysymbol}">C</mi>
    <mrow data-mjx-texclass="ORD" data-latex="{P}">
      <mi data-latex="P">P</mi>
    </mrow>
  </msub>
  <mspace width="2em" data-latex="\\qquad"></mspace>
  <msub data-latex="\\left(\\frac{\\partial \\Hm}{\\partial T}\\right)_{P}">
    <mrow data-mjx-texclass="INNER" data-latex="\\left(\\frac{\\partial \\Hm}{\\partial T}\\right)">
      <mo data-mjx-texclass="OPEN" data-latex="\\left(">(</mo>
      <mfrac data-latex="\\frac{\\partial \\Hm}{\\partial T}">
        <mrow data-latex="\\partial \\Hm">
          <mi data-latex="\\partial">&#x2202;</mi>
          <mi data-latex="\\Hm">H</mi>
        </mrow>
        <mrow data-latex="\\partial T">
          <mi data-latex="\\partial">&#x2202;</mi>
          <mi data-latex="T">T</mi>
        </mrow>
      </mfrac>
      <mo data-mjx-texclass="CLOSE" data-latex="\\right)">)</mo>
    </mrow>
    <mrow data-mjx-texclass="ORD" data-latex="{P}">
      <mi data-latex="P">P</mi>
    </mrow>
  </msub>
  <mspace width="-0.667em" linebreak="nobreak" data-latex="\\Partial*{\\Hm}{T}{P}"></mspace>
  <mo data-latex="=">=</mo>
  <msub data-latex="\\intensive{\\heatcapacitysymbol}_{P}">
