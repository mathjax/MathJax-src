exports[`Thermodynamics Symbols Redefine \\excess 1`] = `
"<math xmlns="http://www.w3.org/1998/Math/MathML" data-latex="
      \\begin{gather*}
        \\HE^\\std = \\Hm^{\\excess,\\std} = \\HE(T,\\Pstd)
          = \\HR(T,\\Pstd) - \\HR^\\IS(T,\\Pstd) = \\HR^\\std - \\HR^{\\IS,\\std} \\\\
        \\renewcommand{\\excess}{{EX}}
        \\HE^\\std = \\Hm^{\\excess,\\std} = \\HE(T,\\Pstd)
          = \\HR(T,\\Pstd) - \\HR^\\IS(T,\\Pstd)
      \\end{gather*}
    " display="block">
  <mtable displaystyle="true" columnspacing="1em" rowspacing="3pt" data-break-align="middle" data-latex="{EX},\\std} = \\HE(T,\\Pstd)
          = \\HR(T,\\Pstd) - \\HR^\\IS(T,\\Pstd)
      \\end{gather*}">
    <mtr data-latex="\\intensive{\\EnthalpySymbol}^{\\excess,\\std}=\\Hm^{\\excess,\\std}=\\intensive{\\EnthalpySymbol}^{\\excess}(T,P^{\\std})=\\intensive{\\EnthalpySymbol}^{\\residual}(T,P^{\\std})-\\intensive{\\EnthalpySymbol}^{\\residual,{\\text{IS}}}(T,P^{\\std})=\\intensive{\\EnthalpySymbol}^{\\residual,\\std}-\\intensive{\\EnthalpySymbol}^{\\residual,{\\text{IS}},\\std}">
      <mtd>
        <msup data-latex="\\intensive{\\EnthalpySymbol}^{\\excess,\\std}">
          <mi data-latex="\\intensive{\\EnthalpySymbol}">H</mi>
          <mrow data-mjx-texclass="ORD" data-latex="{\\excess,\\std}">
            <mi data-latex="\\excess">E</mi>
            <mo data-latex=",">,</mo>
            <mo data-latex="\\std">&#x2218;</mo>
          </mrow>
        </msup>
        <mo data-latex="=">=</mo>
        <msup data-latex="\\Hm^{\\excess,\\std}">
          <mi data-latex="\\Hm">H</mi>
          <mrow data-mjx-texclass="ORD" data-latex="{\\excess,\\std}">
            <mi data-latex="\\excess">E</mi>
            <mo data-latex=",">,</mo>
            <mo data-latex="\\std">&#x2218;</mo>
          </mrow>
        </msup>
        <mo data-latex="=">=</mo>
        <msup data-latex="\\intensive{\\EnthalpySymbol}^{\\excess}">
          <mi data-latex="\\intensive{\\EnthalpySymbol}">H</mi>
          <mrow data-mjx-texclass="ORD" data-latex="{\\excess}">
            <mi data-latex="\\excess">E</mi>
          </mrow>
        </msup>
        <mo data-latex="(" stretchy="false">(</mo>
        <mi data-latex="T">T</mi>
        <mo data-latex=",">,</mo>
        <msup data-latex="P^{\\std}">
          <mi data-latex="P">P</mi>
          <mrow data-mjx-texclass="ORD" data-latex="{\\std}">
            <mo data-latex="\\std">&#x2218;</mo>
          </mrow>
        </msup>
        <mo data-latex=")" stretchy="false">)</mo>
        <mo data-latex="=">=</mo>
        <msup data-latex="\\intensive{\\EnthalpySymbol}^{\\residual}">
          <mi data-latex="\\intensive{\\EnthalpySymbol}">H</mi>
          <mrow data-mjx-texclass="ORD" data-latex="{\\residual}">
            <mi data-latex="\\residual">R</mi>
          </mrow>
        </msup>
        <mo data-latex="(" stretchy="false">(</mo>
        <mi data-latex="T">T</mi>
        <mo data-latex=",">,</mo>
