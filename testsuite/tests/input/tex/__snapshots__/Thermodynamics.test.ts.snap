  <mspace width="0.056em" linebreak="nobreak" data-latex="\\partialmolar{\\EntropySymbol}_i"></mspace>
  <mo data-latex="=">=</mo>
  <mspace width="0.111em" linebreak="nobreak" data-latex="\\mkern2mu"></mspace>
  <mover data-latex="\\overline{\\mkern-2mu{\\EntropySymbol}_{i}^{\\IGM}\\mkern-1mu}">
    <mrow data-latex="\\mkern-2mu{\\EntropySymbol}_{i}^{\\IGM}\\mkern-1mu">
      <mspace width="-0.111em" linebreak="nobreak" data-latex="\\mkern-2mu"></mspace>
      <msubsup data-latex="{\\EntropySymbol}_{i}^{{\\text{IGM}}}">
