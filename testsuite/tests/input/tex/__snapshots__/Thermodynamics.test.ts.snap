        <mrow data-mjx-texclass="ORD" data-latex="{j\\neq i}">
          <mi data-latex="j">j</mi>
          <mo data-latex="\\neq">&#x2260;</mo>
          <mi data-latex="i">i</mi>
        </mrow>
      </msub>
    </mrow>
  </msub>
  <mspace width="-0.667em" linebreak="nobreak" data-latex="\\PartialMixSecond*{\\Gt}{\\Nt_i}{P}{T,\\allNsbut{i}}"></mspace>
  <mo data-latex="=">=</mo>
  <msub data-latex="\\left(\\frac{\\partial^2 \\Gt}{\\partial P\\partial \\Nt_i}\\right)_{T,\\Nt_{j\\neq i}}">
    <mrow data-mjx-texclass="INNER" data-latex="\\left(\\frac{\\partial^2 \\Gt}{\\partial P\\partial \\Nt_i}\\right)">
      <mo data-mjx-texclass="OPEN" data-latex="\\left(">(</mo>
      <mfrac data-latex="\\frac{\\partial^2 \\Gt}{\\partial P\\partial \\Nt_i}">
        <mrow data-latex="\\partial^2  \\Gt">
          <msup data-latex="\\partial^2">
            <mi data-latex="\\partial">&#x2202;</mi>
            <mn data-latex="2">2</mn>
          </msup>
          <mrow data-mjx-texclass="ORD" data-latex="\\extensive{\\GibbsSymbol}">
            <mspace width="0.056em" linebreak="nobreak" data-latex="\\mkern1mu"></mspace>
            <munder data-latex="\\underline{\\mkern-1mu \\GibbsSymbol\\mkern-4mu}">
              <mrow data-latex="\\mkern-1mu \\GibbsSymbol\\mkern-4mu">
                <mspace width="-0.056em" linebreak="nobreak" data-latex="\\mkern-1mu"></mspace>
                <mi data-latex="\\GibbsSymbol">G</mi>
                <mspace width="-0.222em" linebreak="nobreak" data-latex="\\mkern-4mu"></mspace>
              </mrow>
              <mo accent="true">&#x2015;</mo>
            </munder>
            <mspace width="0.222em" linebreak="nobreak" data-latex="\\mkern4mu"></mspace>
          </mrow>
        </mrow>
        <mrow data-latex="\\partial P\\partial \\Nt_i">
          <mi data-latex="\\partial">&#x2202;</mi>
          <mi data-latex="P">P</mi>
          <mi data-latex="\\partial">&#x2202;</mi>
          <msub data-latex="\\Nt_i">
            <mi data-latex="\\Nt">n</mi>
            <mi data-latex="i">i</mi>
          </msub>
        </mrow>
      </mfrac>
      <mo data-mjx-texclass="CLOSE" data-latex="\\right)">)</mo>
    </mrow>
    <mrow data-mjx-texclass="ORD" data-latex="{T,\\Nt_{j\\neq i}}">
      <mi data-latex="T">T</mi>
      <mo data-latex=",">,</mo>
      <msub data-latex="\\Nt_{j\\neq i}">
        <mi data-latex="\\Nt">n</mi>
        <mrow data-mjx-texclass="ORD" data-latex="{j\\neq i}">
          <mi data-latex="j">j</mi>
          <mo data-latex="\\neq">&#x2260;</mo>
          <mi data-latex="i">i</mi>
        </mrow>
      </msub>
    </mrow>
  </msub>
  <mspace width="-0.667em" linebreak="nobreak" data-latex="\\PartialMixSecond*{\\Gt}{P}{\\Nt_i}{T,\\allNsbut{i}}"></mspace>
  <mo data-latex="=">=</mo>
  <msub data-latex="\\left(\\frac{\\partial \\Gpm_i}{\\partial P}\\right)_{T,\\allNs}">
    <mrow data-mjx-texclass="INNER" data-latex="\\left(\\frac{\\partial \\Gpm_i}{\\partial P}\\right)">
      <mo data-mjx-texclass="OPEN" data-latex="\\left(">(</mo>
      <mfrac data-latex="\\frac{\\partial \\Gpm_i}{\\partial P}">
        <mrow data-latex="\\partialmolar{\\GibbsSymbol}_i">
          <mi data-latex="\\partial">&#x2202;</mi>
          <mspace width="0.111em" linebreak="nobreak" data-latex="\\mkern2mu"></mspace>
          <mover data-latex="\\overline{\\mkern-2mu{\\GibbsSymbol}_{i}\\mkern-1mu}">
            <mrow data-latex="\\mkern-2mu{\\GibbsSymbol}_{i}\\mkern-1mu">
              <mspace width="-0.111em" linebreak="nobreak" data-latex="\\mkern-2mu"></mspace>
              <msub data-latex="{\\GibbsSymbol}_{i}">
                <mrow data-mjx-texclass="ORD" data-latex="{\\GibbsSymbol}">
                  <mi data-latex="\\GibbsSymbol">G</mi>
                </mrow>
                <mrow data-mjx-texclass="ORD" data-latex="{i}">
                  <mi data-latex="i">i</mi>
                </mrow>
              </msub>
              <mspace width="-0.056em" linebreak="nobreak" data-latex="\\mkern-1mu"></mspace>
            </mrow>
            <mo accent="true">&#x2015;</mo>
          </mover>
          <mspace width="0.056em" linebreak="nobreak" data-latex="\\partialmolar{\\GibbsSymbol}_i"></mspace>
        </mrow>
        <mrow data-latex="\\partial P">
          <mi data-latex="\\partial">&#x2202;</mi>
          <mi data-latex="P">P</mi>
        </mrow>
      </mfrac>
      <mo data-mjx-texclass="CLOSE" data-latex="\\right)">)</mo>
    </mrow>
    <mrow data-mjx-texclass="ORD" data-latex="{T,\\allNs}">
      <mi data-latex="T">T</mi>
      <mo data-latex=",">,</mo>
      <mrow data-mjx-texclass="ORD" data-latex="\\allNs">
        <mover>
          <mi data-latex="\\Nt">n</mi>
          <mo stretchy="false">&#x2192;</mo>
        </mover>
      </mrow>
    </mrow>
  </msub>
</math>"
`;

exports[`Thermodynamics Partials \\PartialMixSecond* 1`] = `
"<math xmlns="http://www.w3.org/1998/Math/MathML" data-latex="
      \\cPpm_i = T\\Partial*{\\Spm_i}{T}{P,\\allXs}
          = T\\PartialMixSecond*{\\St}{T}{\\Nt_i}{P,\\allNsbut{i}}
          = -T\\Partial{^3\\Gt}{T^2\\partial\\Nt_i}{P,\\allNsbut{i}}
    " display="block">
  <mspace width="0.111em" linebreak="nobreak" data-latex="\\mkern2mu"></mspace>
  <mover data-latex="\\overline{\\mkern-2mu{\\intensive{\\heatcapacitysymbol}}_{P,i}\\mkern-1mu}">
    <mrow data-latex="\\mkern-2mu{\\intensive{\\heatcapacitysymbol}}_{P,i}\\mkern-1mu">
      <mspace width="-0.111em" linebreak="nobreak" data-latex="\\mkern-2mu"></mspace>
      <msub data-latex="{\\intensive{\\heatcapacitysymbol}}_{P,i}">
        <mrow data-mjx-texclass="ORD" data-latex="{\\intensive{\\heatcapacitysymbol}}">
          <mi data-latex="\\intensive{\\heatcapacitysymbol}">C</mi>
        </mrow>
        <mrow data-mjx-texclass="ORD" data-latex="{P,i}">
          <mi data-latex="P">P</mi>
          <mo data-latex=",">,</mo>
          <mi data-latex="i">i</mi>
        </mrow>
      </msub>
      <mspace width="-0.056em" linebreak="nobreak" data-latex="\\mkern-1mu"></mspace>
    </mrow>
    <mo accent="true">&#x2015;</mo>
  </mover>
  <mspace width="0.056em" linebreak="nobreak" data-latex="\\cPpm_i"></mspace>
  <mo data-latex="=">=</mo>
  <mi data-latex="T">T</mi>
  <msub data-latex="\\left(\\frac{\\partial \\Spm_i}{\\partial T}\\right)_{P,\\allXs}">
    <mrow data-mjx-texclass="INNER" data-latex="\\left(\\frac{\\partial \\Spm_i}{\\partial T}\\right)">
      <mo data-mjx-texclass="OPEN" data-latex="\\left(">(</mo>
      <mfrac data-latex="\\frac{\\partial \\Spm_i}{\\partial T}">
        <mrow data-latex="\\partialmolar{\\EntropySymbol}_i">
          <mi data-latex="\\partial">&#x2202;</mi>
          <mspace width="0.111em" linebreak="nobreak" data-latex="\\mkern2mu"></mspace>
          <mover data-latex="\\overline{\\mkern-2mu{\\EntropySymbol}_{i}\\mkern-1mu}">
            <mrow data-latex="\\mkern-2mu{\\EntropySymbol}_{i}\\mkern-1mu">
              <mspace width="-0.111em" linebreak="nobreak" data-latex="\\mkern-2mu"></mspace>
              <msub data-latex="{\\EntropySymbol}_{i}">
                <mrow data-mjx-texclass="ORD" data-latex="{\\EntropySymbol}">
                  <mi data-latex="\\EntropySymbol">S</mi>
                </mrow>
                <mrow data-mjx-texclass="ORD" data-latex="{i}">
                  <mi data-latex="i">i</mi>
                </mrow>
              </msub>
              <mspace width="-0.056em" linebreak="nobreak" data-latex="\\mkern-1mu"></mspace>
            </mrow>
            <mo accent="true">&#x2015;</mo>
          </mover>
          <mspace width="0.056em" linebreak="nobreak" data-latex="\\partialmolar{\\EntropySymbol}_i"></mspace>
        </mrow>
        <mrow data-latex="\\partial T">
          <mi data-latex="\\partial">&#x2202;</mi>
          <mi data-latex="T">T</mi>
        </mrow>
      </mfrac>
      <mo data-mjx-texclass="CLOSE" data-latex="\\right)">)</mo>
    </mrow>
    <mrow data-mjx-texclass="ORD" data-latex="{P,\\allXs}">
      <mi data-latex="P">P</mi>
      <mo data-latex=",">,</mo>
      <mrow data-mjx-texclass="ORD" data-latex="\\allXs">
        <mover>
          <mi data-latex="x">x</mi>
          <mo stretchy="false">&#x2192;</mo>
        </mover>
      </mrow>
    </mrow>
  </msub>
  <mspace width="-0.667em" linebreak="nobreak" data-latex="\\Partial*{\\Spm_i}{T}{P,\\allXs}"></mspace>
  <mo data-latex="=">=</mo>
  <mi data-latex="T">T</mi>
  <msub data-latex="\\left(\\frac{\\partial^2 \\St}{\\partial T\\partial \\Nt_i}\\right)_{P,\\Nt_{j\\neq i}}">
    <mrow data-mjx-texclass="INNER" data-latex="\\left(\\frac{\\partial^2 \\St}{\\partial T\\partial \\Nt_i}\\right)">
      <mo data-mjx-texclass="OPEN" data-latex="\\left(">(</mo>
      <mfrac data-latex="\\frac{\\partial^2 \\St}{\\partial T\\partial \\Nt_i}">
        <mrow data-latex="\\partial^2  \\St">
          <msup data-latex="\\partial^2">
            <mi data-latex="\\partial">&#x2202;</mi>
            <mn data-latex="2">2</mn>
          </msup>
          <mrow data-mjx-texclass="ORD" data-latex="\\extensive{\\EntropySymbol}">
            <mspace width="0.056em" linebreak="nobreak" data-latex="\\mkern1mu"></mspace>
            <munder data-latex="\\underline{\\mkern-1mu \\EntropySymbol\\mkern-4mu}">
              <mrow data-latex="\\mkern-1mu \\EntropySymbol\\mkern-4mu">
                <mspace width="-0.056em" linebreak="nobreak" data-latex="\\mkern-1mu"></mspace>
                <mi data-latex="\\EntropySymbol">S</mi>
                <mspace width="-0.222em" linebreak="nobreak" data-latex="\\mkern-4mu"></mspace>
              </mrow>
              <mo accent="true">&#x2015;</mo>
            </munder>
            <mspace width="0.222em" linebreak="nobreak" data-latex="\\mkern4mu"></mspace>
          </mrow>
        </mrow>
        <mrow data-latex="\\partial T\\partial \\Nt_i">
          <mi data-latex="\\partial">&#x2202;</mi>
          <mi data-latex="T">T</mi>
          <mi data-latex="\\partial">&#x2202;</mi>
          <msub data-latex="\\Nt_i">
            <mi data-latex="\\Nt">n</mi>
            <mi data-latex="i">i</mi>
          </msub>
        </mrow>
      </mfrac>
      <mo data-mjx-texclass="CLOSE" data-latex="\\right)">)</mo>
    </mrow>
    <mrow data-mjx-texclass="ORD" data-latex="{P,\\Nt_{j\\neq i}}">
      <mi data-latex="P">P</mi>
      <mo data-latex=",">,</mo>
      <msub data-latex="\\Nt_{j\\neq i}">
        <mi data-latex="\\Nt">n</mi>
        <mrow data-mjx-texclass="ORD" data-latex="{j\\neq i}">
          <mi data-latex="j">j</mi>
          <mo data-latex="\\neq">&#x2260;</mo>
          <mi data-latex="i">i</mi>
        </mrow>
      </msub>
    </mrow>
  </msub>
  <mspace width="-0.667em" linebreak="nobreak" data-latex="\\PartialMixSecond*{\\St}{T}{\\Nt_i}{P,\\allNsbut{i}}"></mspace>
  <mo data-latex="=">=</mo>
  <mo data-latex="-">&#x2212;</mo>
  <mi data-latex="T">T</mi>
  <msub data-latex="\\left(\\frac{\\partial ^3\\Gt}{\\partial T^2\\partial\\Nt_i}\\right)_{P,\\Nt_{j\\neq i}}">
    <mrow data-mjx-texclass="INNER" data-latex="\\left(\\frac{\\partial ^3\\Gt}{\\partial T^2\\partial\\Nt_i}\\right)">
      <mo data-mjx-texclass="OPEN" data-latex="\\left(">(</mo>
      <mfrac data-latex="\\frac{\\partial ^3\\Gt}{\\partial T^2\\partial\\Nt_i}">
        <mrow data-latex="\\partial ^3 \\Gt">
          <msup data-latex="\\partial^3">
            <mi data-latex="\\partial">&#x2202;</mi>
            <mn data-latex="3">3</mn>
          </msup>
          <mrow data-mjx-texclass="ORD" data-latex="\\extensive{\\GibbsSymbol}">
            <mspace width="0.056em" linebreak="nobreak" data-latex="\\mkern1mu"></mspace>
            <munder data-latex="\\underline{\\mkern-1mu \\GibbsSymbol\\mkern-4mu}">
              <mrow data-latex="\\mkern-1mu \\GibbsSymbol\\mkern-4mu">
                <mspace width="-0.056em" linebreak="nobreak" data-latex="\\mkern-1mu"></mspace>
                <mi data-latex="\\GibbsSymbol">G</mi>
                <mspace width="-0.222em" linebreak="nobreak" data-latex="\\mkern-4mu"></mspace>
              </mrow>
              <mo accent="true">&#x2015;</mo>
            </munder>
            <mspace width="0.222em" linebreak="nobreak" data-latex="\\mkern4mu"></mspace>
          </mrow>
        </mrow>
        <mrow data-latex="\\partial T^2 \\partial\\Nt_i">
          <mi data-latex="\\partial">&#x2202;</mi>
          <msup data-latex="T^2">
            <mi data-latex="T">T</mi>
            <mn data-latex="2">2</mn>
          </msup>
          <mi data-latex="\\partial">&#x2202;</mi>
          <msub data-latex="\\Nt_i">
            <mi data-latex="\\Nt">n</mi>
            <mi data-latex="i">i</mi>
          </msub>
        </mrow>
      </mfrac>
      <mo data-mjx-texclass="CLOSE" data-latex="\\right)">)</mo>
    </mrow>
    <mrow data-mjx-texclass="ORD" data-latex="{P,\\Nt_{j\\neq i}}">
      <mi data-latex="P">P</mi>
      <mo data-latex=",">,</mo>
      <msub data-latex="\\Nt_{j\\neq i}">
        <mi data-latex="\\Nt">n</mi>
        <mrow data-mjx-texclass="ORD" data-latex="{j\\neq i}">
          <mi data-latex="j">j</mi>
          <mo data-latex="\\neq">&#x2260;</mo>
          <mi data-latex="i">i</mi>
        </mrow>
      </msub>
    </mrow>
  </msub>
</math>"
`;

exports[`Thermodynamics Partials \\PartialMixSecondBigg 1`] = `
"<math xmlns="http://www.w3.org/1998/Math/MathML" data-latex="
      \\PartialMixSecondbigg{\\Ht}{T}{P}{\\allNs},
      \\PartialMixSecondBigg{\\Ht}{T}{P}{\\allNs}
    " display="block">
  <mrow data-mjx-texclass="OPEN" data-latex="\\biggl(">
    <mo minsize="2.047em" maxsize="2.047em">(</mo>
  </mrow>
  <mfrac data-latex="\\frac{\\partial^2 \\Ht}{\\partial T\\partial P}">
    <mrow data-latex="\\partial^2  \\Ht">
      <msup data-latex="\\partial^2">
        <mi data-latex="\\partial">&#x2202;</mi>
        <mn data-latex="2">2</mn>
      </msup>
      <mrow data-mjx-texclass="ORD" data-latex="\\extensive{\\EnthalpySymbol}">
        <mspace width="0.056em" linebreak="nobreak" data-latex="\\mkern1mu"></mspace>
        <munder data-latex="\\underline{\\mkern-1mu \\EnthalpySymbol\\mkern-4mu}">
          <mrow data-latex="\\mkern-1mu \\EnthalpySymbol\\mkern-4mu">
            <mspace width="-0.056em" linebreak="nobreak" data-latex="\\mkern-1mu"></mspace>
            <mi data-latex="\\EnthalpySymbol">H</mi>
            <mspace width="-0.222em" linebreak="nobreak" data-latex="\\mkern-4mu"></mspace>
          </mrow>
          <mo accent="true">&#x2015;</mo>
        </munder>
        <mspace width="0.222em" linebreak="nobreak" data-latex="\\mkern4mu"></mspace>
      </mrow>
    </mrow>
    <mrow data-latex="\\partial T\\partial P">
      <mi data-latex="\\partial">&#x2202;</mi>
      <mi data-latex="T">T</mi>
      <mi data-latex="\\partial">&#x2202;</mi>
      <mi data-latex="P">P</mi>
    </mrow>
  </mfrac>
  <msub data-latex="\\biggr)_{\\allNs}">
    <mrow data-mjx-texclass="CLOSE" data-latex="\\biggr)">
      <mo minsize="2.047em" maxsize="2.047em">)</mo>
    </mrow>
    <mrow data-mjx-texclass="ORD" data-latex="{\\allNs}">
      <mrow data-mjx-texclass="ORD" data-latex="\\allNs">
        <mover>
          <mi data-latex="\\Nt">n</mi>
          <mo stretchy="false">&#x2192;</mo>
        </mover>
      </mrow>
    </mrow>
  </msub>
  <mo data-latex=",">,</mo>
  <mrow data-mjx-texclass="OPEN" data-latex="\\Biggl(">
    <mo minsize="2.470em" maxsize="2.470em">(</mo>
  </mrow>
  <mfrac data-latex="\\frac{\\partial^2 \\Ht}{\\partial T\\partial P}">
    <mrow data-latex="\\partial^2  \\Ht">
      <msup data-latex="\\partial^2">
        <mi data-latex="\\partial">&#x2202;</mi>
        <mn data-latex="2">2</mn>
      </msup>
      <mrow data-mjx-texclass="ORD" data-latex="\\extensive{\\EnthalpySymbol}">
        <mspace width="0.056em" linebreak="nobreak" data-latex="\\mkern1mu"></mspace>
        <munder data-latex="\\underline{\\mkern-1mu \\EnthalpySymbol\\mkern-4mu}">
          <mrow data-latex="\\mkern-1mu \\EnthalpySymbol\\mkern-4mu">
            <mspace width="-0.056em" linebreak="nobreak" data-latex="\\mkern-1mu"></mspace>
            <mi data-latex="\\EnthalpySymbol">H</mi>
            <mspace width="-0.222em" linebreak="nobreak" data-latex="\\mkern-4mu"></mspace>
          </mrow>
          <mo accent="true">&#x2015;</mo>
        </munder>
        <mspace width="0.222em" linebreak="nobreak" data-latex="\\mkern4mu"></mspace>
      </mrow>
    </mrow>
    <mrow data-latex="\\partial T\\partial P">
      <mi data-latex="\\partial">&#x2202;</mi>
      <mi data-latex="T">T</mi>
      <mi data-latex="\\partial">&#x2202;</mi>
      <mi data-latex="P">P</mi>
    </mrow>
  </mfrac>
  <msub data-latex="\\Biggr)_{\\allNs}">
    <mrow data-mjx-texclass="CLOSE" data-latex="\\Biggr)">
      <mo minsize="2.470em" maxsize="2.470em">)</mo>
    </mrow>
    <mrow data-mjx-texclass="ORD" data-latex="{\\allNs}">
      <mrow data-mjx-texclass="ORD" data-latex="\\allNs">
        <mover>
          <mi data-latex="\\Nt">n</mi>
          <mo stretchy="false">&#x2192;</mo>
        </mover>
      </mrow>
    </mrow>
  </msub>
</math>"
`;

exports[`Thermodynamics Partials \\PartialMixSecondinline 1`] = `
"<math xmlns="http://www.w3.org/1998/Math/MathML" data-latex="
      \\Vpm_i = \\Partialinline{\\Vt}{\\Nt_i}{T,P,\\allNsbut{i}}
        = \\PartialMixSecondinline{\\Gt}{\\Nt_i}{P}{T,\\allNsbut{i}}
        = \\PartialMixSecondinline{\\Gt}{P}{\\Nt_i}{T,\\allNsbut{i}}
        = \\Partialinline{\\Gpm_i}{P}{T,\\allNs}
    " display="block">
  <mspace width="0.111em" linebreak="nobreak" data-latex="\\mkern2mu"></mspace>
  <mover data-latex="\\overline{\\mkern-2mu{\\VolumeSymbol}_{i}\\mkern-1mu}">
    <mrow data-latex="\\mkern-2mu{\\VolumeSymbol}_{i}\\mkern-1mu">
      <mspace width="-0.111em" linebreak="nobreak" data-latex="\\mkern-2mu"></mspace>
      <msub data-latex="{\\VolumeSymbol}_{i}">
        <mrow data-mjx-texclass="ORD" data-latex="{\\VolumeSymbol}">
          <mi data-latex="\\VolumeSymbol">V</mi>
        </mrow>
        <mrow data-mjx-texclass="ORD" data-latex="{i}">
          <mi data-latex="i">i</mi>
        </mrow>
      </msub>
      <mspace width="-0.056em" linebreak="nobreak" data-latex="\\mkern-1mu"></mspace>
    </mrow>
    <mo accent="true">&#x2015;</mo>
  </mover>
  <mspace width="0.056em" linebreak="nobreak" data-latex="\\partialmolar{\\VolumeSymbol}_i"></mspace>
  <mo data-latex="=">=</mo>
  <msub data-latex="\\left(\\partial \\Vt/\\partial \\Nt_i\\right)_{T,P,\\Nt_{j\\neq i}}">
    <mrow data-mjx-texclass="INNER" data-latex="\\left(\\partial \\Vt/\\partial \\Nt_i\\right)">
      <mo data-mjx-texclass="OPEN" data-latex="\\left(">(</mo>
      <mi data-latex="\\partial">&#x2202;</mi>
      <mrow data-mjx-texclass="ORD" data-latex="\\extensive{\\VolumeSymbol}">
        <mspace width="0.056em" linebreak="nobreak" data-latex="\\mkern1mu"></mspace>
        <munder data-latex="\\underline{\\mkern-1mu \\VolumeSymbol\\mkern-4mu}">
          <mrow data-latex="\\mkern-1mu \\VolumeSymbol\\mkern-4mu">
            <mspace width="-0.056em" linebreak="nobreak" data-latex="\\mkern-1mu"></mspace>
            <mi data-latex="\\VolumeSymbol">V</mi>
            <mspace width="-0.222em" linebreak="nobreak" data-latex="\\mkern-4mu"></mspace>
          </mrow>
          <mo accent="true">&#x2015;</mo>
        </munder>
        <mspace width="0.222em" linebreak="nobreak" data-latex="\\mkern4mu"></mspace>
      </mrow>
      <mo data-latex="/">/</mo>
      <mi data-latex="\\partial">&#x2202;</mi>
      <msub data-latex="\\Nt_i">
        <mi data-latex="\\Nt">n</mi>
        <mi data-latex="i">i</mi>
      </msub>
      <mo data-mjx-texclass="CLOSE" data-latex="\\right)">)</mo>
    </mrow>
    <mrow data-mjx-texclass="ORD" data-latex="{T,P,\\Nt_{j\\neq i}}">
      <mi data-latex="T">T</mi>
      <mo data-latex=",">,</mo>
      <mi data-latex="P">P</mi>
      <mo data-latex=",">,</mo>
      <msub data-latex="\\Nt_{j\\neq i}">
        <mi data-latex="\\Nt">n</mi>
        <mrow data-mjx-texclass="ORD" data-latex="{j\\neq i}">
          <mi data-latex="j">j</mi>
          <mo data-latex="\\neq">&#x2260;</mo>
          <mi data-latex="i">i</mi>
        </mrow>
      </msub>
    </mrow>
  </msub>
  <mo data-latex="=">=</mo>
  <msub data-latex="\\left(\\partial^2  \\Gt/\\partial \\Nt_i\\partial P\\right)_{T,\\Nt_{j\\neq i}}">
    <mrow data-mjx-texclass="INNER" data-latex="\\left(\\partial^2  \\Gt/\\partial \\Nt_i\\partial P\\right)">
      <mo data-mjx-texclass="OPEN" data-latex="\\left(">(</mo>
      <msup data-latex="\\partial^2">
        <mi data-latex="\\partial">&#x2202;</mi>
        <mn data-latex="2">2</mn>
      </msup>
      <mrow data-mjx-texclass="ORD" data-latex="\\extensive{\\GibbsSymbol}">
        <mspace width="0.056em" linebreak="nobreak" data-latex="\\mkern1mu"></mspace>
        <munder data-latex="\\underline{\\mkern-1mu \\GibbsSymbol\\mkern-4mu}">
          <mrow data-latex="\\mkern-1mu \\GibbsSymbol\\mkern-4mu">
            <mspace width="-0.056em" linebreak="nobreak" data-latex="\\mkern-1mu"></mspace>
            <mi data-latex="\\GibbsSymbol">G</mi>
            <mspace width="-0.222em" linebreak="nobreak" data-latex="\\mkern-4mu"></mspace>
          </mrow>
          <mo accent="true">&#x2015;</mo>
        </munder>
        <mspace width="0.222em" linebreak="nobreak" data-latex="\\mkern4mu"></mspace>
      </mrow>
      <mo data-latex="/">/</mo>
      <mi data-latex="\\partial">&#x2202;</mi>
      <msub data-latex="\\Nt_i">
        <mi data-latex="\\Nt">n</mi>
        <mi data-latex="i">i</mi>
      </msub>
      <mi data-latex="\\partial">&#x2202;</mi>
      <mi data-latex="P">P</mi>
      <mo data-mjx-texclass="CLOSE" data-latex="\\right)">)</mo>
    </mrow>
    <mrow data-mjx-texclass="ORD" data-latex="{T,\\Nt_{j\\neq i}}">
      <mi data-latex="T">T</mi>
      <mo data-latex=",">,</mo>
      <msub data-latex="\\Nt_{j\\neq i}">
        <mi data-latex="\\Nt">n</mi>
        <mrow data-mjx-texclass="ORD" data-latex="{j\\neq i}">
          <mi data-latex="j">j</mi>
          <mo data-latex="\\neq">&#x2260;</mo>
          <mi data-latex="i">i</mi>
        </mrow>
      </msub>
    </mrow>
  </msub>
  <mo data-latex="=">=</mo>
  <msub data-latex="\\left(\\partial^2  \\Gt/\\partial P\\partial \\Nt_i\\right)_{T,\\Nt_{j\\neq i}}">
    <mrow data-mjx-texclass="INNER" data-latex="\\left(\\partial^2  \\Gt/\\partial P\\partial \\Nt_i\\right)">
      <mo data-mjx-texclass="OPEN" data-latex="\\left(">(</mo>
      <msup data-latex="\\partial^2">
        <mi data-latex="\\partial">&#x2202;</mi>
        <mn data-latex="2">2</mn>
      </msup>
