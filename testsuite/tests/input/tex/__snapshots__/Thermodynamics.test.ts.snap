exports[`Thermodynamics Jacobians Jacobian m x m 1`] = `
"<math xmlns="http://www.w3.org/1998/Math/MathML" data-latex="
      \\Jacobian{f_1,\\dots,f_m}{x_1,\\dots,x_m}
          = \\Jacobiandet{f_1,\\dots,f_m}{x_1,\\dots,x_m}
    " display="block">
  <mfrac data-latex="\\frac{\\partial(f_1,\\dots,f_m)}{\\partial(x_1,\\dots,x_m)}">
