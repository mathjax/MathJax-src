          <mi data-latex="\\intensive{\\EntropySymbol}">S</mi>
        </mrow>
        <mrow data-mjx-texclass="ORD" data-latex="{i}">
          <mi data-latex="i">i</mi>
        </mrow>
        <mrow data-mjx-texclass="ORD" data-latex="{\\residual}">
          <mi data-latex="\\residual">R</mi>
        </mrow>
      </msubsup>
      <mspace width="-0.056em" linebreak="nobreak" data-latex="\\mkern-1mu"></mspace>
    </mrow>
    <mo accent="true">&#x2015;</mo>
  </mover>
  <mspace width="0.056em" linebreak="nobreak" data-latex="\\SRpm_i"></mspace>
</math>"
`;

exports[`Thermodynamics enironments thermoparentheses 1`] = `
"<math xmlns="http://www.w3.org/1998/Math/MathML" data-latex="
      \\begin{thermoparentheses}
        \\Partial*{\\Vm}{T}{P} = \\PartialMixSecond{\\Gm}{T}{P}{}
            = \\PartialMixSecond{\\Gm}{P}{T}{}
            = -\\Partial{\\Sm}{P}{T}
      \\end{thermoparentheses}
    " display="block">
  <msub data-latex="\\left(\\frac{\\partial \\Vm}{\\partial T}\\right)_{P}">
    <mrow data-mjx-texclass="INNER" data-latex="\\left(\\frac{\\partial \\Vm}{\\partial T}\\right)">
      <mo data-mjx-texclass="OPEN" data-latex="\\left(">(</mo>
      <mfrac data-latex="\\frac{\\partial \\Vm}{\\partial T}">
        <mrow data-latex="\\partial \\Vm">
          <mi data-latex="\\partial">&#x2202;</mi>
          <mi data-latex="\\Vm">V</mi>
        </mrow>
        <mrow data-latex="\\partial T">
          <mi data-latex="\\partial">&#x2202;</mi>
          <mi data-latex="T">T</mi>
        </mrow>
      </mfrac>
      <mo data-mjx-texclass="CLOSE" data-latex="\\right)">)</mo>
    </mrow>
    <mrow data-mjx-texclass="ORD" data-latex="{P}">
      <mi data-latex="P">P</mi>
    </mrow>
  </msub>
  <mspace width="-0.667em" linebreak="nobreak" data-latex="\\Partial*{\\Vm}{T}{P}"></mspace>
  <mo data-latex="=">=</mo>
  <mrow data-mjx-texclass="INNER" data-latex="\\left(\\frac{\\partial^2 \\Gm}{\\partial T\\partial P}\\right)">
    <mo data-mjx-texclass="OPEN" data-latex="\\left(">(</mo>
    <mfrac data-latex="\\frac{\\partial^2 \\Gm}{\\partial T\\partial P}">
      <mrow data-latex="\\partial^2  \\Gm">
        <msup data-latex="\\partial^2">
          <mi data-latex="\\partial">&#x2202;</mi>
          <mn data-latex="2">2</mn>
        </msup>
        <mi data-latex="\\Gm">G</mi>
      </mrow>
      <mrow data-latex="\\partial T\\partial P">
        <mi data-latex="\\partial">&#x2202;</mi>
        <mi data-latex="T">T</mi>
        <mi data-latex="\\partial">&#x2202;</mi>
        <mi data-latex="P">P</mi>
      </mrow>
    </mfrac>
    <mo data-mjx-texclass="CLOSE" data-latex="\\right)">)</mo>
  </mrow>
  <mo data-latex="=">=</mo>
  <mrow data-mjx-texclass="INNER" data-latex="\\left(\\frac{\\partial^2 \\Gm}{\\partial P\\partial T}\\right)">
    <mo data-mjx-texclass="OPEN" data-latex="\\left(">(</mo>
    <mfrac data-latex="\\frac{\\partial^2 \\Gm}{\\partial P\\partial T}">
      <mrow data-latex="\\partial^2  \\Gm">
        <msup data-latex="\\partial^2">
          <mi data-latex="\\partial">&#x2202;</mi>
          <mn data-latex="2">2</mn>
        </msup>
        <mi data-latex="\\Gm">G</mi>
      </mrow>
      <mrow data-latex="\\partial P\\partial T">
        <mi data-latex="\\partial">&#x2202;</mi>
        <mi data-latex="P">P</mi>
        <mi data-latex="\\partial">&#x2202;</mi>
        <mi data-latex="T">T</mi>
      </mrow>
    </mfrac>
    <mo data-mjx-texclass="CLOSE" data-latex="\\right)">)</mo>
  </mrow>
  <mo data-latex="=">=</mo>
  <mo data-latex="-">&#x2212;</mo>
  <msub data-latex="\\left(\\frac{\\partial \\Sm}{\\partial P}\\right)_{T}">
    <mrow data-mjx-texclass="INNER" data-latex="\\left(\\frac{\\partial \\Sm}{\\partial P}\\right)">
      <mo data-mjx-texclass="OPEN" data-latex="\\left(">(</mo>
      <mfrac data-latex="\\frac{\\partial \\Sm}{\\partial P}">
        <mrow data-latex="\\partial \\Sm">
          <mi data-latex="\\partial">&#x2202;</mi>
          <mi data-latex="\\Sm">S</mi>
        </mrow>
        <mrow data-latex="\\partial P">
          <mi data-latex="\\partial">&#x2202;</mi>
          <mi data-latex="P">P</mi>
        </mrow>
      </mfrac>
      <mo data-mjx-texclass="CLOSE" data-latex="\\right)">)</mo>
    </mrow>
    <mrow data-mjx-texclass="ORD" data-latex="{T}">
      <mi data-latex="T">T</mi>
    </mrow>
  </msub>
</math>"
`;

