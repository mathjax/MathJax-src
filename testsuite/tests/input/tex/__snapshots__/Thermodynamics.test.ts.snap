exports[`Thermodynamics Partials \\PartialMixSecond 1`] = `
"<math xmlns="http://www.w3.org/1998/Math/MathML" data-latex="
      \\Vpm_i = \\Partial*{\\Vt}{\\Nt_i}{T,P,\\allNsbut{i}}
          = \\PartialMixSecond*{\\Gt}{\\Nt_i}{P}{T,\\allNsbut{i}}
          = \\PartialMixSecond*{\\Gt}{P}{\\Nt_i}{T,\\allNsbut{i}}
          = \\Partial{\\Gpm_i}{P}{T,\\allNs}
    " display="block">
  <mspace width="0.111em" linebreak="nobreak" data-latex="\\mkern2mu"></mspace>
  <mover data-latex="\\overline{\\mkern-2mu{\\VolumeSymbol}_{i}\\mkern-1mu}">
    <mrow data-latex="\\mkern-2mu{\\VolumeSymbol}_{i}\\mkern-1mu">
      <mspace width="-0.111em" linebreak="nobreak" data-latex="\\mkern-2mu"></mspace>
      <msub data-latex="{\\VolumeSymbol}_{i}">
        <mrow data-mjx-texclass="ORD" data-latex="{\\VolumeSymbol}">
          <mi data-latex="\\VolumeSymbol">V</mi>
        </mrow>
        <mrow data-mjx-texclass="ORD" data-latex="{i}">
          <mi data-latex="i">i</mi>
        </mrow>
      </msub>
      <mspace width="-0.056em" linebreak="nobreak" data-latex="\\mkern-1mu"></mspace>
    </mrow>
    <mo accent="true">&#x2015;</mo>
  </mover>
  <mspace width="0.056em" linebreak="nobreak" data-latex="\\partialmolar{\\VolumeSymbol}_i"></mspace>
  <mo data-latex="=">=</mo>
  <msub data-latex="\\left(\\frac{\\partial \\Vt}{\\partial \\Nt_i}\\right)_{T,P,\\Nt_{j\\neq i}}">
    <mrow data-mjx-texclass="INNER" data-latex="\\left(\\frac{\\partial \\Vt}{\\partial \\Nt_i}\\right)">
      <mo data-mjx-texclass="OPEN" data-latex="\\left(">(</mo>
      <mfrac data-latex="\\frac{\\partial \\Vt}{\\partial \\Nt_i}">
        <mrow data-latex="\\partial \\Vt">
          <mi data-latex="\\partial">&#x2202;</mi>
          <mrow data-mjx-texclass="ORD" data-latex="\\extensive{\\VolumeSymbol}">
            <mspace width="0.056em" linebreak="nobreak" data-latex="\\mkern1mu"></mspace>
            <munder data-latex="\\underline{\\mkern-1mu \\VolumeSymbol\\mkern-4mu}">
              <mrow data-latex="\\mkern-1mu \\VolumeSymbol\\mkern-4mu">
                <mspace width="-0.056em" linebreak="nobreak" data-latex="\\mkern-1mu"></mspace>
                <mi data-latex="\\VolumeSymbol">V</mi>
                <mspace width="-0.222em" linebreak="nobreak" data-latex="\\mkern-4mu"></mspace>
              </mrow>
              <mo accent="true">&#x2015;</mo>
            </munder>
            <mspace width="0.222em" linebreak="nobreak" data-latex="\\mkern4mu"></mspace>
          </mrow>
        </mrow>
        <mrow data-latex="\\partial \\Nt_i">
          <mi data-latex="\\partial">&#x2202;</mi>
          <msub data-latex="\\Nt_i">
            <mi data-latex="\\Nt">n</mi>
            <mi data-latex="i">i</mi>
          </msub>
        </mrow>
      </mfrac>
      <mo data-mjx-texclass="CLOSE" data-latex="\\right)">)</mo>
    </mrow>
    <mrow data-mjx-texclass="ORD" data-latex="{T,P,\\Nt_{j\\neq i}}">
      <mi data-latex="T">T</mi>
      <mo data-latex=",">,</mo>
      <mi data-latex="P">P</mi>
      <mo data-latex=",">,</mo>
      <msub data-latex="\\Nt_{j\\neq i}">
        <mi data-latex="\\Nt">n</mi>
        <mrow data-mjx-texclass="ORD" data-latex="{j\\neq i}">
          <mi data-latex="j">j</mi>
          <mo data-latex="\\neq">&#x2260;</mo>
          <mi data-latex="i">i</mi>
        </mrow>
      </msub>
    </mrow>
  </msub>
  <mspace width="-0.667em" linebreak="nobreak" data-latex="\\Partial*{\\Vt}{\\Nt_i}{T,P,\\allNsbut{i}}"></mspace>
  <mo data-latex="=">=</mo>
  <msub data-latex="\\left(\\frac{\\partial^2 \\Gt}{\\partial \\Nt_i\\partial P}\\right)_{T,\\Nt_{j\\neq i}}">
    <mrow data-mjx-texclass="INNER" data-latex="\\left(\\frac{\\partial^2 \\Gt}{\\partial \\Nt_i\\partial P}\\right)">
      <mo data-mjx-texclass="OPEN" data-latex="\\left(">(</mo>
      <mfrac data-latex="\\frac{\\partial^2 \\Gt}{\\partial \\Nt_i\\partial P}">
        <mrow data-latex="\\partial^2  \\Gt">
          <msup data-latex="\\partial^2">
            <mi data-latex="\\partial">&#x2202;</mi>
            <mn data-latex="2">2</mn>
