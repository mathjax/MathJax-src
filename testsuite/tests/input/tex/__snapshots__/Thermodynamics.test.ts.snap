exports[`Thermodynamics Partials \\Partial* 1`] = `
"<math xmlns="http://www.w3.org/1998/Math/MathML" data-latex="
      \\Vpm_i = \\Partial*{\\Vt}{\\Nt_i}{T,P,\\allNsbut{i}}
          = \\Partial{\\smash{\\Gpm_i}}{P}{T,\\allNs}
    " display="block">
  <mspace width="0.111em" linebreak="nobreak" data-latex="\\mkern2mu"></mspace>
  <mover data-latex="\\overline{\\mkern-2mu{\\VolumeSymbol}_{i}\\mkern-1mu}">
    <mrow data-latex="\\mkern-2mu{\\VolumeSymbol}_{i}\\mkern-1mu">
      <mspace width="-0.111em" linebreak="nobreak" data-latex="\\mkern-2mu"></mspace>
      <msub data-latex="{\\VolumeSymbol}_{i}">
        <mrow data-mjx-texclass="ORD" data-latex="{\\VolumeSymbol}">
          <mi data-latex="\\VolumeSymbol">V</mi>
        </mrow>
        <mrow data-mjx-texclass="ORD" data-latex="{i}">
          <mi data-latex="i">i</mi>
        </mrow>
      </msub>
      <mspace width="-0.056em" linebreak="nobreak" data-latex="\\mkern-1mu"></mspace>
    </mrow>
    <mo accent="true">&#x2015;</mo>
  </mover>
  <mspace width="0.056em" linebreak="nobreak" data-latex="\\partialmolar{\\VolumeSymbol}_i"></mspace>
  <mo data-latex="=">=</mo>
  <msub data-latex="\\left(\\frac{\\partial \\Vt}{\\partial \\Nt_i}\\right)_{T,P,\\Nt_{j\\neq i}}">
    <mrow data-mjx-texclass="INNER" data-latex="\\left(\\frac{\\partial \\Vt}{\\partial \\Nt_i}\\right)">
      <mo data-mjx-texclass="OPEN" data-latex="\\left(">(</mo>
      <mfrac data-latex="\\frac{\\partial \\Vt}{\\partial \\Nt_i}">
        <mrow data-latex="\\partial \\Vt">
          <mi data-latex="\\partial">&#x2202;</mi>
          <mrow data-mjx-texclass="ORD" data-latex="\\extensive{\\VolumeSymbol}">
            <mspace width="0.056em" linebreak="nobreak" data-latex="\\mkern1mu"></mspace>
            <munder data-latex="\\underline{\\mkern-1mu \\VolumeSymbol\\mkern-4mu}">
              <mrow data-latex="\\mkern-1mu \\VolumeSymbol\\mkern-4mu">
                <mspace width="-0.056em" linebreak="nobreak" data-latex="\\mkern-1mu"></mspace>
                <mi data-latex="\\VolumeSymbol">V</mi>
                <mspace width="-0.222em" linebreak="nobreak" data-latex="\\mkern-4mu"></mspace>
              </mrow>
              <mo accent="true">&#x2015;</mo>
            </munder>
            <mspace width="0.222em" linebreak="nobreak" data-latex="\\mkern4mu"></mspace>
          </mrow>
        </mrow>
        <mrow data-latex="\\partial \\Nt_i">
          <mi data-latex="\\partial">&#x2202;</mi>
          <msub data-latex="\\Nt_i">
            <mi data-latex="\\Nt">n</mi>
            <mi data-latex="i">i</mi>
          </msub>
        </mrow>
      </mfrac>
      <mo data-mjx-texclass="CLOSE" data-latex="\\right)">)</mo>
    </mrow>
    <mrow data-mjx-texclass="ORD" data-latex="{T,P,\\Nt_{j\\neq i}}">
      <mi data-latex="T">T</mi>
      <mo data-latex=",">,</mo>
      <mi data-latex="P">P</mi>
      <mo data-latex=",">,</mo>
      <msub data-latex="\\Nt_{j\\neq i}">
        <mi data-latex="\\Nt">n</mi>
        <mrow data-mjx-texclass="ORD" data-latex="{j\\neq i}">
          <mi data-latex="j">j</mi>
          <mo data-latex="\\neq">&#x2260;</mo>
          <mi data-latex="i">i</mi>
        </mrow>
      </msub>
    </mrow>
  </msub>
  <mspace width="-0.667em" linebreak="nobreak" data-latex="\\Partial*{\\Vt}{\\Nt_i}{T,P,\\allNsbut{i}}"></mspace>
  <mo data-latex="=">=</mo>
  <msub data-latex="\\left(\\frac{\\partial \\smash{\\Gpm_i}}{\\partial P}\\right)_{T,\\allNs}">
    <mrow data-mjx-texclass="INNER" data-latex="\\left(\\frac{\\partial \\smash{\\Gpm_i}}{\\partial P}\\right)">
      <mo data-mjx-texclass="OPEN" data-latex="\\left(">(</mo>
      <mfrac data-latex="\\frac{\\partial \\smash{\\Gpm_i}}{\\partial P}">
        <mrow data-latex="\\partial \\smash{\\Gpm_i}">
          <mi data-latex="\\partial">&#x2202;</mi>
          <mrow data-mjx-texclass="ORD" data-latex="\\smash{\\Gpm_i}">
            <mpadded height="0" depth="0">
              <mspace width="0.111em" linebreak="nobreak" data-latex="\\mkern2mu"></mspace>
              <mover data-latex="\\overline{\\mkern-2mu{\\GibbsSymbol}_{i}\\mkern-1mu}">
                <mrow data-latex="\\mkern-2mu{\\GibbsSymbol}_{i}\\mkern-1mu">
                  <mspace width="-0.111em" linebreak="nobreak" data-latex="\\mkern-2mu"></mspace>
                  <msub data-latex="{\\GibbsSymbol}_{i}">
                    <mrow data-mjx-texclass="ORD" data-latex="{\\GibbsSymbol}">
                      <mi data-latex="\\GibbsSymbol">G</mi>
                    </mrow>
                    <mrow data-mjx-texclass="ORD" data-latex="{i}">
                      <mi data-latex="i">i</mi>
                    </mrow>
                  </msub>
                  <mspace width="-0.056em" linebreak="nobreak" data-latex="\\mkern-1mu"></mspace>
                </mrow>
                <mo accent="true">&#x2015;</mo>
              </mover>
              <mspace width="0.056em" linebreak="nobreak" data-latex="\\partialmolar{\\GibbsSymbol}_i"></mspace>
            </mpadded>
          </mrow>
        </mrow>
        <mrow data-latex="\\partial P">
          <mi data-latex="\\partial">&#x2202;</mi>
          <mi data-latex="P">P</mi>
        </mrow>
      </mfrac>
      <mo data-mjx-texclass="CLOSE" data-latex="\\right)">)</mo>
    </mrow>
    <mrow data-mjx-texclass="ORD" data-latex="{T,\\allNs}">
      <mi data-latex="T">T</mi>
      <mo data-latex=",">,</mo>
      <mrow data-mjx-texclass="ORD" data-latex="\\allNs">
        <mover>
          <mi data-latex="\\Nt">n</mi>
          <mo stretchy="false">&#x2192;</mo>
        </mover>
      </mrow>
    </mrow>
  </msub>
</math>"
`;

exports[`Thermodynamics Partials \\Partial* with \\allXsbut 1`] = `
"<math xmlns="http://www.w3.org/1998/Math/MathML" data-latex="
      \\Partial*{\\Hm}{x_i}{T,P,\\allXsbut{i}}
          = \\Partial*{\\Hm}{x_i}{T,P,\\allXsbut[m]{i}}
          = \\Hpm_i - \\Hpm_\\ncomponents
    " display="block">
  <msub data-latex="\\left(\\frac{\\partial \\Hm}{\\partial x_i}\\right)_{T,P,x_{j\\neq i,\\ncomponents}}">
    <mrow data-mjx-texclass="INNER" data-latex="\\left(\\frac{\\partial \\Hm}{\\partial x_i}\\right)">
      <mo data-mjx-texclass="OPEN" data-latex="\\left(">(</mo>
      <mfrac data-latex="\\frac{\\partial \\Hm}{\\partial x_i}">
        <mrow data-latex="\\partial \\Hm">
          <mi data-latex="\\partial">&#x2202;</mi>
          <mi data-latex="\\Hm">H</mi>
        </mrow>
        <mrow data-latex="\\partial x_i">
          <mi data-latex="\\partial">&#x2202;</mi>
          <msub data-latex="x_i">
            <mi data-latex="x">x</mi>
            <mi data-latex="i">i</mi>
          </msub>
        </mrow>
      </mfrac>
      <mo data-mjx-texclass="CLOSE" data-latex="\\right)">)</mo>
    </mrow>
    <mrow data-mjx-texclass="ORD" data-latex="{T,P,x_{j\\neq i,\\ncomponents}}">
      <mi data-latex="T">T</mi>
      <mo data-latex=",">,</mo>
      <mi data-latex="P">P</mi>
      <mo data-latex=",">,</mo>
      <msub data-latex="x_{j\\neq i,\\ncomponents}">
        <mi data-latex="x">x</mi>
        <mrow data-mjx-texclass="ORD" data-latex="{j\\neq i,\\ncomponents}">
          <mi data-latex="j">j</mi>
          <mo data-latex="\\neq">&#x2260;</mo>
          <mi data-latex="i">i</mi>
          <mo data-latex=",">,</mo>
          <mi data-latex="\\ncomponents">C</mi>
        </mrow>
      </msub>
    </mrow>
  </msub>
  <mspace width="-0.667em" linebreak="nobreak" data-latex="\\Partial*{\\Hm}{x_i}{T,P,\\allXsbut{i}}"></mspace>
  <mo data-latex="=">=</mo>
  <msub data-latex="\\left(\\frac{\\partial \\Hm}{\\partial x_i}\\right)_{T,P,x_{m\\neq i,\\ncomponents}}">
    <mrow data-mjx-texclass="INNER" data-latex="\\left(\\frac{\\partial \\Hm}{\\partial x_i}\\right)">
      <mo data-mjx-texclass="OPEN" data-latex="\\left(">(</mo>
      <mfrac data-latex="\\frac{\\partial \\Hm}{\\partial x_i}">
        <mrow data-latex="\\partial \\Hm">
          <mi data-latex="\\partial">&#x2202;</mi>
          <mi data-latex="\\Hm">H</mi>
        </mrow>
        <mrow data-latex="\\partial x_i">
          <mi data-latex="\\partial">&#x2202;</mi>
          <msub data-latex="x_i">
            <mi data-latex="x">x</mi>
            <mi data-latex="i">i</mi>
          </msub>
        </mrow>
      </mfrac>
      <mo data-mjx-texclass="CLOSE" data-latex="\\right)">)</mo>
    </mrow>
    <mrow data-mjx-texclass="ORD" data-latex="{T,P,x_{m\\neq i,\\ncomponents}}">
      <mi data-latex="T">T</mi>
      <mo data-latex=",">,</mo>
      <mi data-latex="P">P</mi>
      <mo data-latex=",">,</mo>
      <msub data-latex="x_{m\\neq i,\\ncomponents}">
        <mi data-latex="x">x</mi>
        <mrow data-mjx-texclass="ORD" data-latex="{m\\neq i,\\ncomponents}">
          <mi data-latex="m">m</mi>
          <mo data-latex="\\neq">&#x2260;</mo>
          <mi data-latex="i">i</mi>
          <mo data-latex=",">,</mo>
          <mi data-latex="\\ncomponents">C</mi>
        </mrow>
      </msub>
    </mrow>
  </msub>
  <mspace width="-0.667em" linebreak="nobreak" data-latex="\\Partial*{\\Hm}{x_i}{T,P,\\allXsbut[m]{i}}"></mspace>
  <mo data-latex="=">=</mo>
  <mspace width="0.111em" linebreak="nobreak" data-latex="\\mkern2mu"></mspace>
  <mover data-latex="\\overline{\\mkern-2mu{\\EnthalpySymbol}_{i}\\mkern-1mu}">
    <mrow data-latex="\\mkern-2mu{\\EnthalpySymbol}_{i}\\mkern-1mu">
      <mspace width="-0.111em" linebreak="nobreak" data-latex="\\mkern-2mu"></mspace>
      <msub data-latex="{\\EnthalpySymbol}_{i}">
        <mrow data-mjx-texclass="ORD" data-latex="{\\EnthalpySymbol}">
          <mi data-latex="\\EnthalpySymbol">H</mi>
        </mrow>
        <mrow data-mjx-texclass="ORD" data-latex="{i}">
          <mi data-latex="i">i</mi>
        </mrow>
      </msub>
      <mspace width="-0.056em" linebreak="nobreak" data-latex="\\mkern-1mu"></mspace>
    </mrow>
    <mo accent="true">&#x2015;</mo>
  </mover>
  <mspace width="0.056em" linebreak="nobreak" data-latex="\\partialmolar{\\EnthalpySymbol}_i"></mspace>
  <mo data-latex="-">&#x2212;</mo>
  <mspace width="0.111em" linebreak="nobreak" data-latex="\\mkern2mu"></mspace>
  <mover data-latex="\\overline{\\mkern-2mu{\\EnthalpySymbol}_{\\ncomponents}\\mkern-1mu}">
    <mrow data-latex="\\mkern-2mu{\\EnthalpySymbol}_{\\ncomponents}\\mkern-1mu">
      <mspace width="-0.111em" linebreak="nobreak" data-latex="\\mkern-2mu"></mspace>
      <msub data-latex="{\\EnthalpySymbol}_{\\ncomponents}">
        <mrow data-mjx-texclass="ORD" data-latex="{\\EnthalpySymbol}">
          <mi data-latex="\\EnthalpySymbol">H</mi>
        </mrow>
        <mrow data-mjx-texclass="ORD" data-latex="{\\ncomponents}">
          <mi data-latex="\\ncomponents">C</mi>
        </mrow>
      </msub>
      <mspace width="-0.056em" linebreak="nobreak" data-latex="\\mkern-1mu"></mspace>
    </mrow>
    <mo accent="true">&#x2015;</mo>
  </mover>
  <mspace width="0.056em" linebreak="nobreak" data-latex="\\partialmolar{\\EnthalpySymbol}_\\ncomponents"></mspace>
</math>"
`;

exports[`Thermodynamics Partials \\PartialBigg 1`] = `
"<math xmlns="http://www.w3.org/1998/Math/MathML" data-latex="
      \\Vpm_i = \\Partial*{\\Vt}{\\Nt_i}{T,P,\\allNsbut{i}}
          = \\Partial*{\\Gpm_i}{P}{T,\\allNs}
          = \\PartialBigg*{\\Gpm_i}{P}{T,\\allNs}
          = RT\\Partial*{\\log\\fmix_i}{P}{T,\\allNs}
          = RT\\PartialBigg*{\\log\\fmix_i}{P}{T,\\allNs}
          = RT\\Partialbigg{\\log\\fmix_i}{P}{T,\\allNs}
    " display="block">
  <mspace width="0.111em" linebreak="nobreak" data-latex="\\mkern2mu"></mspace>
  <mover data-latex="\\overline{\\mkern-2mu{\\VolumeSymbol}_{i}\\mkern-1mu}">
    <mrow data-latex="\\mkern-2mu{\\VolumeSymbol}_{i}\\mkern-1mu">
      <mspace width="-0.111em" linebreak="nobreak" data-latex="\\mkern-2mu"></mspace>
      <msub data-latex="{\\VolumeSymbol}_{i}">
        <mrow data-mjx-texclass="ORD" data-latex="{\\VolumeSymbol}">
          <mi data-latex="\\VolumeSymbol">V</mi>
        </mrow>
        <mrow data-mjx-texclass="ORD" data-latex="{i}">
          <mi data-latex="i">i</mi>
        </mrow>
      </msub>
      <mspace width="-0.056em" linebreak="nobreak" data-latex="\\mkern-1mu"></mspace>
    </mrow>
    <mo accent="true">&#x2015;</mo>
  </mover>
  <mspace width="0.056em" linebreak="nobreak" data-latex="\\partialmolar{\\VolumeSymbol}_i"></mspace>
  <mo data-latex="=">=</mo>
  <msub data-latex="\\left(\\frac{\\partial \\Vt}{\\partial \\Nt_i}\\right)_{T,P,\\Nt_{j\\neq i}}">
    <mrow data-mjx-texclass="INNER" data-latex="\\left(\\frac{\\partial \\Vt}{\\partial \\Nt_i}\\right)">
      <mo data-mjx-texclass="OPEN" data-latex="\\left(">(</mo>
