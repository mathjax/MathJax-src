        <mrow data-latex="\\partial \\Vt">
          <mi data-latex="\\partial">&#x2202;</mi>
          <mrow data-mjx-texclass="ORD" data-latex="\\extensive{\\VolumeSymbol}">
            <mspace width="0.056em" linebreak="nobreak" data-latex="\\mkern1mu"></mspace>
            <munder data-latex="\\underline{\\mkern-1mu \\VolumeSymbol\\mkern-4mu}">
              <mrow data-latex="\\mkern-1mu \\VolumeSymbol\\mkern-4mu">
                <mspace width="-0.056em" linebreak="nobreak" data-latex="\\mkern-1mu"></mspace>
                <mi data-latex="\\VolumeSymbol">V</mi>
                <mspace width="-0.222em" linebreak="nobreak" data-latex="\\mkern-4mu"></mspace>
              </mrow>
              <mo accent="true">&#x2015;</mo>
            </munder>
            <mspace width="0.222em" linebreak="nobreak" data-latex="\\mkern4mu"></mspace>
          </mrow>
        </mrow>
      </mfrac>
      <mo data-mjx-texclass="CLOSE" data-latex="\\right)">)</mo>
    </mrow>
    <mrow data-mjx-texclass="ORD" data-latex="{\\extensive{\\EntropySymbol},\\allNs}">
      <mrow data-mjx-texclass="ORD" data-latex="\\extensive{\\EntropySymbol}">
        <mspace width="0.056em" linebreak="nobreak" data-latex="\\mkern1mu"></mspace>
        <munder data-latex="\\underline{\\mkern-1mu \\EntropySymbol\\mkern-4mu}">
          <mrow data-latex="\\mkern-1mu \\EntropySymbol\\mkern-4mu">
            <mspace width="-0.056em" linebreak="nobreak" data-latex="\\mkern-1mu"></mspace>
            <mi data-latex="\\EntropySymbol">S</mi>
            <mspace width="-0.222em" linebreak="nobreak" data-latex="\\mkern-4mu"></mspace>
          </mrow>
          <mo accent="true">&#x2015;</mo>
        </munder>
        <mspace width="0.222em" linebreak="nobreak" data-latex="\\mkern4mu"></mspace>
      </mrow>
      <mo data-latex=",">,</mo>
      <mrow data-mjx-texclass="ORD" data-latex="\\allNs">
        <mover>
          <mi data-latex="\\Nt">n</mi>
          <mo stretchy="false">&#x2192;</mo>
        </mover>
      </mrow>
    </mrow>
  </msub>
  <mspace width="-0.667em" linebreak="nobreak" data-latex="\\Partial*{\\Ut}{\\Vt}{\\St,\\allNs}"></mspace>
  <mi data-latex="d">d</mi>
  <mrow data-mjx-texclass="ORD" data-latex="\\extensive{\\VolumeSymbol}">
    <mspace width="0.056em" linebreak="nobreak" data-latex="\\mkern1mu"></mspace>
    <munder data-latex="\\underline{\\mkern-1mu \\VolumeSymbol\\mkern-4mu}">
      <mrow data-latex="\\mkern-1mu \\VolumeSymbol\\mkern-4mu">
        <mspace width="-0.056em" linebreak="nobreak" data-latex="\\mkern-1mu"></mspace>
        <mi data-latex="\\VolumeSymbol">V</mi>
        <mspace width="-0.222em" linebreak="nobreak" data-latex="\\mkern-4mu"></mspace>
      </mrow>
      <mo accent="true">&#x2015;</mo>
    </munder>
    <mspace width="0.222em" linebreak="nobreak" data-latex="\\mkern4mu"></mspace>
  </mrow>
  <mo data-latex="+">+</mo>
  <munderover data-latex="\\sum_{i=1}^{\\ncomponents}">
    <mo data-latex="\\sum">&#x2211;</mo>
    <mrow data-mjx-texclass="ORD" data-latex="{i=1}">
      <mi data-latex="i">i</mi>
      <mo data-latex="=">=</mo>
      <mn data-latex="1">1</mn>
    </mrow>
    <mrow data-mjx-texclass="ORD" data-latex="{\\ncomponents}">
      <mi data-latex="\\ncomponents">C</mi>
    </mrow>
  </munderover>
  <msub data-latex="\\left(\\frac{\\partial \\Ut}{\\partial \\Nt_i}\\right)_{\\extensive{\\EntropySymbol},\\extensive{\\VolumeSymbol},\\Nt_{j\\neq i}}">
    <mrow data-mjx-texclass="INNER" data-latex="\\left(\\frac{\\partial \\Ut}{\\partial \\Nt_i}\\right)">
      <mo data-mjx-texclass="OPEN" data-latex="\\left(">(</mo>
      <mfrac data-latex="\\frac{\\partial \\Ut}{\\partial \\Nt_i}">
        <mrow data-latex="\\partial \\Ut">
          <mi data-latex="\\partial">&#x2202;</mi>
          <mrow data-mjx-texclass="ORD" data-latex="\\extensive{\\InternalEnergySymbol}">
            <mspace width="0.056em" linebreak="nobreak" data-latex="\\mkern1mu"></mspace>
            <munder data-latex="\\underline{\\mkern-1mu \\InternalEnergySymbol\\mkern-4mu}">
              <mrow data-latex="\\mkern-1mu \\InternalEnergySymbol\\mkern-4mu">
                <mspace width="-0.056em" linebreak="nobreak" data-latex="\\mkern-1mu"></mspace>
                <mi data-latex="\\InternalEnergySymbol">U</mi>
                <mspace width="-0.222em" linebreak="nobreak" data-latex="\\mkern-4mu"></mspace>
              </mrow>
              <mo accent="true">&#x2015;</mo>
            </munder>
            <mspace width="0.222em" linebreak="nobreak" data-latex="\\mkern4mu"></mspace>
          </mrow>
        </mrow>
        <mrow data-latex="\\partial \\Nt_i">
          <mi data-latex="\\partial">&#x2202;</mi>
          <msub data-latex="\\Nt_i">
            <mi data-latex="\\Nt">n</mi>
            <mi data-latex="i">i</mi>
          </msub>
        </mrow>
      </mfrac>
      <mo data-mjx-texclass="CLOSE" data-latex="\\right)">)</mo>
    </mrow>
    <mrow data-mjx-texclass="ORD" data-latex="{\\extensive{\\EntropySymbol},\\extensive{\\VolumeSymbol},\\Nt_{j\\neq i}}">
      <mrow data-mjx-texclass="ORD" data-latex="\\extensive{\\EntropySymbol}">
        <mspace width="0.056em" linebreak="nobreak" data-latex="\\mkern1mu"></mspace>
        <munder data-latex="\\underline{\\mkern-1mu \\EntropySymbol\\mkern-4mu}">
          <mrow data-latex="\\mkern-1mu \\EntropySymbol\\mkern-4mu">
            <mspace width="-0.056em" linebreak="nobreak" data-latex="\\mkern-1mu"></mspace>
            <mi data-latex="\\EntropySymbol">S</mi>
            <mspace width="-0.222em" linebreak="nobreak" data-latex="\\mkern-4mu"></mspace>
          </mrow>
          <mo accent="true">&#x2015;</mo>
        </munder>
        <mspace width="0.222em" linebreak="nobreak" data-latex="\\mkern4mu"></mspace>
      </mrow>
      <mo data-latex=",">,</mo>
      <mrow data-mjx-texclass="ORD" data-latex="\\extensive{\\VolumeSymbol}">
        <mspace width="0.056em" linebreak="nobreak" data-latex="\\mkern1mu"></mspace>
        <munder data-latex="\\underline{\\mkern-1mu \\VolumeSymbol\\mkern-4mu}">
          <mrow data-latex="\\mkern-1mu \\VolumeSymbol\\mkern-4mu">
            <mspace width="-0.056em" linebreak="nobreak" data-latex="\\mkern-1mu"></mspace>
            <mi data-latex="\\VolumeSymbol">V</mi>
            <mspace width="-0.222em" linebreak="nobreak" data-latex="\\mkern-4mu"></mspace>
          </mrow>
          <mo accent="true">&#x2015;</mo>
        </munder>
        <mspace width="0.222em" linebreak="nobreak" data-latex="\\mkern4mu"></mspace>
      </mrow>
      <mo data-latex=",">,</mo>
      <msub data-latex="\\Nt_{j\\neq i}">
        <mi data-latex="\\Nt">n</mi>
        <mrow data-mjx-texclass="ORD" data-latex="{j\\neq i}">
          <mi data-latex="j">j</mi>
          <mo data-latex="\\neq">&#x2260;</mo>
          <mi data-latex="i">i</mi>
        </mrow>
      </msub>
    </mrow>
  </msub>
  <mspace width="-0.667em" linebreak="nobreak" data-latex="\\Partial*{\\Ut}{\\Nt_i}{\\St,\\Vt,\\allNsbut{i}}"></mspace>
  <mi data-latex="d">d</mi>
  <msub data-latex="\\Nt_i">
    <mi data-latex="\\Nt">n</mi>
    <mi data-latex="i">i</mi>
  </msub>
</math>"
`;

exports[`Thermodynamics Examples Eq 2 1`] = `
"<math xmlns="http://www.w3.org/1998/Math/MathML" data-latex="
      \\begin{thermoextensiveplain}
      \\begin{thermomolesrange}
      \\renewcommand{\\Nt}{N}
      \\renewcommand{\\ncomponents}{\\mathcal{C}}
      d\\Ut = \\Partial*{\\Ut}{\\St}{\\Vt,\\allNs} d\\St
        + \\Partial*{\\Ut}{\\Vt}{\\St,\\allNs} d\\Vt
        + \\sumall_i \\Partial*{\\Ut}{\\Nt_i}{\\St,\\Vt,\\allNsbut{i}} d\\Nt_i
      \\end{thermomolesrange}
      \\end{thermoextensiveplain}
      \\renewcommand{\\Nt}{n}
      \\renewcommand{\\ncomponents}{C}
    " display="block">
  <mi data-latex="d">d</mi>
  <mi data-latex="\\Ut">U</mi>
  <mo data-latex="=">=</mo>
  <msub data-latex="\\left(\\frac{\\partial \\Ut}{\\partial \\St}\\right)_{\\Vt,N_1,\\dotsc,N_{\\mathcal{C}}}">
    <mrow data-mjx-texclass="INNER" data-latex="\\left(\\frac{\\partial \\Ut}{\\partial \\St}\\right)">
      <mo data-mjx-texclass="OPEN" data-latex="\\left(">(</mo>
      <mfrac data-latex="\\frac{\\partial \\Ut}{\\partial \\St}">
        <mrow data-latex="\\partial \\Ut">
          <mi data-latex="\\partial">&#x2202;</mi>
          <mi data-latex="\\Ut">U</mi>
        </mrow>
        <mrow data-latex="\\partial \\St">
          <mi data-latex="\\partial">&#x2202;</mi>
          <mi data-latex="\\St">S</mi>
        </mrow>
      </mfrac>
      <mo data-mjx-texclass="CLOSE" data-latex="\\right)">)</mo>
    </mrow>
    <mrow data-mjx-texclass="ORD" data-latex="{\\Vt,N_1,\\dotsc,N_{\\mathcal{C}}}">
      <mi data-latex="\\Vt">V</mi>
      <mo data-latex=",">,</mo>
      <msub data-latex="N_1">
        <mi data-latex="N">N</mi>
        <mn data-latex="1">1</mn>
      </msub>
      <mo data-latex=",">,</mo>
      <mo data-latex="\\dotsc">&#x2026;</mo>
      <mo data-latex=",">,</mo>
      <msub data-latex="N_{\\mathcal{C}}">
        <mi data-latex="N">N</mi>
        <mrow data-mjx-texclass="ORD" data-latex="{\\mathcal{C}}">
          <mrow data-mjx-texclass="ORD" data-latex="\\mathcal{C}">
            <mi data-mjx-variant="-tex-calligraphic" mathvariant="script" data-latex="C">C</mi>
          </mrow>
        </mrow>
      </msub>
    </mrow>
  </msub>
  <mspace width="-0.667em" linebreak="nobreak" data-latex="\\Partial*{\\Ut}{\\St}{\\Vt,\\allNs}"></mspace>
  <mi data-latex="d">d</mi>
  <mi data-latex="\\St">S</mi>
  <mo data-latex="+">+</mo>
  <msub data-latex="\\left(\\frac{\\partial \\Ut}{\\partial \\Vt}\\right)_{\\St,N_1,\\dotsc,N_{\\mathcal{C}}}">
    <mrow data-mjx-texclass="INNER" data-latex="\\left(\\frac{\\partial \\Ut}{\\partial \\Vt}\\right)">
      <mo data-mjx-texclass="OPEN" data-latex="\\left(">(</mo>
      <mfrac data-latex="\\frac{\\partial \\Ut}{\\partial \\Vt}">
        <mrow data-latex="\\partial \\Ut">
          <mi data-latex="\\partial">&#x2202;</mi>
          <mi data-latex="\\Ut">U</mi>
        </mrow>
        <mrow data-latex="\\partial \\Vt">
          <mi data-latex="\\partial">&#x2202;</mi>
          <mi data-latex="\\Vt">V</mi>
        </mrow>
      </mfrac>
      <mo data-mjx-texclass="CLOSE" data-latex="\\right)">)</mo>
    </mrow>
    <mrow data-mjx-texclass="ORD" data-latex="{\\St,N_1,\\dotsc,N_{\\mathcal{C}}}">
      <mi data-latex="\\St">S</mi>
      <mo data-latex=",">,</mo>
      <msub data-latex="N_1">
        <mi data-latex="N">N</mi>
        <mn data-latex="1">1</mn>
      </msub>
      <mo data-latex=",">,</mo>
      <mo data-latex="\\dotsc">&#x2026;</mo>
      <mo data-latex=",">,</mo>
      <msub data-latex="N_{\\mathcal{C}}">
        <mi data-latex="N">N</mi>
        <mrow data-mjx-texclass="ORD" data-latex="{\\mathcal{C}}">
          <mrow data-mjx-texclass="ORD" data-latex="\\mathcal{C}">
            <mi data-mjx-variant="-tex-calligraphic" mathvariant="script" data-latex="C">C</mi>
          </mrow>
        </mrow>
      </msub>
    </mrow>
  </msub>
  <mspace width="-0.667em" linebreak="nobreak" data-latex="\\Partial*{\\Ut}{\\Vt}{\\St,\\allNs}"></mspace>
  <mi data-latex="d">d</mi>
  <mi data-latex="\\Vt">V</mi>
  <mo data-latex="+">+</mo>
  <munderover data-latex="\\sum_{i=1}^{\\mathcal{C}}">
    <mo data-latex="\\sum">&#x2211;</mo>
    <mrow data-mjx-texclass="ORD" data-latex="{i=1}">
      <mi data-latex="i">i</mi>
      <mo data-latex="=">=</mo>
      <mn data-latex="1">1</mn>
    </mrow>
    <mrow data-mjx-texclass="ORD" data-latex="{\\mathcal{C}}">
      <mrow data-mjx-texclass="ORD" data-latex="\\mathcal{C}">
        <mi data-mjx-variant="-tex-calligraphic" mathvariant="script" data-latex="C">C</mi>
      </mrow>
    </mrow>
  </munderover>
  <msub data-latex="\\left(\\frac{\\partial \\Ut}{\\partial \\Nt_i}\\right)_{\\St,\\Vt,N_1,\\dotsc,[N_{i}],\\dotsc,N_{\\mathcal{C}}}">
    <mrow data-mjx-texclass="INNER" data-latex="\\left(\\frac{\\partial \\Ut}{\\partial \\Nt_i}\\right)">
      <mo data-mjx-texclass="OPEN" data-latex="\\left(">(</mo>
      <mfrac data-latex="\\frac{\\partial \\Ut}{\\partial \\Nt_i}">
        <mrow data-latex="\\partial \\Ut">
          <mi data-latex="\\partial">&#x2202;</mi>
          <mi data-latex="\\Ut">U</mi>
        </mrow>
        <mrow data-latex="N_i">
          <mi data-latex="\\partial">&#x2202;</mi>
          <msub data-latex="N_i">
            <mi data-latex="N">N</mi>
            <mi data-latex="i">i</mi>
          </msub>
        </mrow>
      </mfrac>
      <mo data-mjx-texclass="CLOSE" data-latex="\\right)">)</mo>
    </mrow>
    <mrow data-mjx-texclass="ORD" data-latex="{\\St,\\Vt,N_1,\\dotsc,[N_{i}],\\dotsc,N_{\\mathcal{C}}}">
      <mi data-latex="\\St">S</mi>
      <mo data-latex=",">,</mo>
      <mi data-latex="\\Vt">V</mi>
      <mo data-latex=",">,</mo>
      <msub data-latex="N_1">
        <mi data-latex="N">N</mi>
        <mn data-latex="1">1</mn>
      </msub>
      <mo data-latex=",">,</mo>
      <mo data-latex="\\dotsc">&#x2026;</mo>
      <mo data-latex=",">,</mo>
      <mo data-latex="[" stretchy="false">[</mo>
      <msub data-latex="N_{i}">
        <mi data-latex="N">N</mi>
        <mrow data-mjx-texclass="ORD" data-latex="{i}">
          <mi data-latex="i">i</mi>
        </mrow>
      </msub>
      <mo data-latex="]" stretchy="false">]</mo>
      <mo data-latex=",">,</mo>
      <mo data-latex="\\dotsc">&#x2026;</mo>
      <mo data-latex=",">,</mo>
      <msub data-latex="N_{\\mathcal{C}}">
        <mi data-latex="N">N</mi>
        <mrow data-mjx-texclass="ORD" data-latex="{\\mathcal{C}}">
          <mrow data-mjx-texclass="ORD" data-latex="\\mathcal{C}">
            <mi data-mjx-variant="-tex-calligraphic" mathvariant="script" data-latex="C">C</mi>
          </mrow>
        </mrow>
      </msub>
    </mrow>
  </msub>
  <mspace width="-0.667em" linebreak="nobreak" data-latex="\\Partial*{\\Ut}{\\Nt_i}{\\St,\\Vt,\\allNsbut{i}}"></mspace>
  <mi data-latex="d">d</mi>
  <msub data-latex="N_i">
    <mi data-latex="N">N</mi>
    <mi data-latex="i">i</mi>
  </msub>
</math>"
`;

exports[`Thermodynamics Examples Eq 3 1`] = `
"<math xmlns="http://www.w3.org/1998/Math/MathML" data-latex="
      \\Partial*{\\Hm}{T}{P} = T\\Partial*{\\Sm}{T}{P}
                           = -T\\PartialSecond*{\\Gm}{T}{P} = \\cP
    " display="block">
  <msub data-latex="\\left(\\frac{\\partial \\Hm}{\\partial T}\\right)_{P}">
    <mrow data-mjx-texclass="INNER" data-latex="\\left(\\frac{\\partial \\Hm}{\\partial T}\\right)">
      <mo data-mjx-texclass="OPEN" data-latex="\\left(">(</mo>
      <mfrac data-latex="\\frac{\\partial \\Hm}{\\partial T}">
        <mrow data-latex="\\partial \\Hm">
          <mi data-latex="\\partial">&#x2202;</mi>
          <mi data-latex="\\Hm">H</mi>
        </mrow>
        <mrow data-latex="\\partial T">
          <mi data-latex="\\partial">&#x2202;</mi>
          <mi data-latex="T">T</mi>
        </mrow>
      </mfrac>
