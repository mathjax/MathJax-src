exports[`Thermodynamics Symbols sumall 1`] = `
"<math xmlns="http://www.w3.org/1998/Math/MathML" data-latex="
      \\sumall_i x_i = 1 \\quad \\text{or} \\quad
        x_\\ncomponents = 1 - \\sumallbutlast_i x_i \\quad \\text{or} \\quad
        \\Gt = \\sumall_j \\mu_j\\Nt_j \\quad \\text{and} \\quad
        K = \\prodall_k a_k^{\\nu_k}
    " display="block">
  <munderover data-latex="\\sum_{i=1}^{\\ncomponents}">
    <mo data-latex="\\sum">&#x2211;</mo>
    <mrow data-mjx-texclass="ORD" data-latex="{i=1}">
      <mi data-latex="i">i</mi>
      <mo data-latex="=">=</mo>
      <mn data-latex="1">1</mn>
