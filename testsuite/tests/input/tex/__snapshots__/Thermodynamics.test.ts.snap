exports[`Thermodynamics Examples Eq 1 1`] = `
"<math xmlns="http://www.w3.org/1998/Math/MathML" data-latex="
      d\\Ut = \\Partial*{\\Ut}{\\St}{\\Vt,\\allNs} d\\St
        + \\Partial*{\\Ut}{\\Vt}{\\St,\\allNs} d\\Vt
        + \\sumall_i \\Partial*{\\Ut}{\\Nt_i}{\\St,\\Vt,\\allNsbut{i}} d\\Nt_i
    " display="block">
  <mi data-latex="d">d</mi>
  <mrow data-mjx-texclass="ORD" data-latex="\\extensive{\\InternalEnergySymbol}">
    <mspace width="0.056em" linebreak="nobreak" data-latex="\\mkern1mu"></mspace>
