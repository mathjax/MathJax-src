    </mrow>
    <mrow data-mjx-texclass="ORD" data-latex="{P}">
      <mi data-latex="P">P</mi>
    </mrow>
  </msub>
  <mspace width="-0.667em" linebreak="nobreak" data-latex="\\Partial*{\\Hm}{T}{P}"></mspace>
  <mo data-latex="=">=</mo>
  <mi data-latex="T">T</mi>
  <msub data-latex="\\left(\\frac{\\partial \\Sm}{\\partial T}\\right)_{P}">
    <mrow data-mjx-texclass="INNER" data-latex="\\left(\\frac{\\partial \\Sm}{\\partial T}\\right)">
      <mo data-mjx-texclass="OPEN" data-latex="\\left(">(</mo>
      <mfrac data-latex="\\frac{\\partial \\Sm}{\\partial T}">
        <mrow data-latex="\\partial \\Sm">
          <mi data-latex="\\partial">&#x2202;</mi>
          <mi data-latex="\\Sm">S</mi>
        </mrow>
        <mrow data-latex="\\partial T">
          <mi data-latex="\\partial">&#x2202;</mi>
          <mi data-latex="T">T</mi>
        </mrow>
      </mfrac>
      <mo data-mjx-texclass="CLOSE" data-latex="\\right)">)</mo>
    </mrow>
    <mrow data-mjx-texclass="ORD" data-latex="{P}">
      <mi data-latex="P">P</mi>
    </mrow>
  </msub>
  <mspace width="-0.667em" linebreak="nobreak" data-latex="\\Partial*{\\Sm}{T}{P}"></mspace>
  <mo data-latex="=">=</mo>
  <mo data-latex="-">&#x2212;</mo>
  <mi data-latex="T">T</mi>
  <msub data-latex="\\left(\\frac{\\partial^2 \\Gm}{\\partial T^2}\\right)_{P}">
    <mrow data-mjx-texclass="INNER" data-latex="\\left(\\frac{\\partial^2 \\Gm}{\\partial T^2}\\right)">
      <mo data-mjx-texclass="OPEN" data-latex="\\left(">(</mo>
      <mfrac data-latex="\\frac{\\partial^2 \\Gm}{\\partial T^2}">
        <mrow data-latex="\\partial^2  \\Gm">
          <msup data-latex="\\partial^2">
            <mi data-latex="\\partial">&#x2202;</mi>
            <mn data-latex="2">2</mn>
          </msup>
          <mi data-latex="\\Gm">G</mi>
        </mrow>
        <mrow data-latex="\\partial T^2">
          <mi data-latex="\\partial">&#x2202;</mi>
          <msup data-latex="T^2">
            <mi data-latex="T">T</mi>
            <mn data-latex="2">2</mn>
          </msup>
        </mrow>
      </mfrac>
      <mo data-mjx-texclass="CLOSE" data-latex="\\right)">)</mo>
    </mrow>
    <mrow data-mjx-texclass="ORD" data-latex="{P}">
      <mi data-latex="P">P</mi>
    </mrow>
  </msub>
  <mspace width="-0.667em" linebreak="nobreak" data-latex="\\PartialSecond*{\\Gm}{T}{P}"></mspace>
  <mo data-latex="=">=</mo>
  <msub data-latex="\\intensive{\\heatcapacitysymbol}_{P}">
    <mi data-latex="\\intensive{\\heatcapacitysymbol}">C</mi>
    <mrow data-mjx-texclass="ORD" data-latex="{P}">
      <mi data-latex="P">P</mi>
    </mrow>
  </msub>
</math>"
`;

exports[`Thermodynamics Examples Partial Derivatives 1`] = `
"<math xmlns="http://www.w3.org/1998/Math/MathML" data-latex="
      \\Partial*{\\Gpm_i}{P}{T,\\allNs}
        = \\PartialMixSecond*{\\Gt}{P}{\\Nt_i}{T,\\allNsbut{i}}
        = \\PartialMixSecond*{\\Gt}{\\Nt_i}{P}{T,\\allNsbut{i}}
        = \\Partial*{\\Vt}{\\Nt_i}{T,P,\\allNsbut{i}} = \\Vpm_i
    " display="block">
  <msub data-latex="\\left(\\frac{\\partial \\Gpm_i}{\\partial P}\\right)_{T,\\allNs}">
    <mrow data-mjx-texclass="INNER" data-latex="\\left(\\frac{\\partial \\Gpm_i}{\\partial P}\\right)">
      <mo data-mjx-texclass="OPEN" data-latex="\\left(">(</mo>
      <mfrac data-latex="\\frac{\\partial \\Gpm_i}{\\partial P}">
        <mrow data-latex="\\partialmolar{\\GibbsSymbol}_i">
          <mi data-latex="\\partial">&#x2202;</mi>
          <mspace width="0.111em" linebreak="nobreak" data-latex="\\mkern2mu"></mspace>
          <mover data-latex="\\overline{\\mkern-2mu{\\GibbsSymbol}_{i}\\mkern-1mu}">
            <mrow data-latex="\\mkern-2mu{\\GibbsSymbol}_{i}\\mkern-1mu">
              <mspace width="-0.111em" linebreak="nobreak" data-latex="\\mkern-2mu"></mspace>
              <msub data-latex="{\\GibbsSymbol}_{i}">
                <mrow data-mjx-texclass="ORD" data-latex="{\\GibbsSymbol}">
                  <mi data-latex="\\GibbsSymbol">G</mi>
                </mrow>
                <mrow data-mjx-texclass="ORD" data-latex="{i}">
                  <mi data-latex="i">i</mi>
                </mrow>
              </msub>
              <mspace width="-0.056em" linebreak="nobreak" data-latex="\\mkern-1mu"></mspace>
            </mrow>
            <mo accent="true">&#x2015;</mo>
          </mover>
          <mspace width="0.056em" linebreak="nobreak" data-latex="\\partialmolar{\\GibbsSymbol}_i"></mspace>
        </mrow>
        <mrow data-latex="\\partial P">
          <mi data-latex="\\partial">&#x2202;</mi>
          <mi data-latex="P">P</mi>
        </mrow>
      </mfrac>
      <mo data-mjx-texclass="CLOSE" data-latex="\\right)">)</mo>
    </mrow>
    <mrow data-mjx-texclass="ORD" data-latex="{T,\\allNs}">
      <mi data-latex="T">T</mi>
      <mo data-latex=",">,</mo>
      <mrow data-mjx-texclass="ORD" data-latex="\\allNs">
        <mover>
          <mi data-latex="\\Nt">n</mi>
          <mo stretchy="false">&#x2192;</mo>
        </mover>
      </mrow>
    </mrow>
  </msub>
  <mspace width="-0.667em" linebreak="nobreak" data-latex="\\Partial*{\\Gpm_i}{P}{T,\\allNs}"></mspace>
  <mo data-latex="=">=</mo>
  <msub data-latex="\\left(\\frac{\\partial^2 \\Gt}{\\partial P\\partial \\Nt_i}\\right)_{T,\\Nt_{j\\neq i}}">
    <mrow data-mjx-texclass="INNER" data-latex="\\left(\\frac{\\partial^2 \\Gt}{\\partial P\\partial \\Nt_i}\\right)">
      <mo data-mjx-texclass="OPEN" data-latex="\\left(">(</mo>
      <mfrac data-latex="\\frac{\\partial^2 \\Gt}{\\partial P\\partial \\Nt_i}">
        <mrow data-latex="\\partial^2  \\Gt">
          <msup data-latex="\\partial^2">
            <mi data-latex="\\partial">&#x2202;</mi>
            <mn data-latex="2">2</mn>
          </msup>
          <mrow data-mjx-texclass="ORD" data-latex="\\extensive{\\GibbsSymbol}">
            <mspace width="0.056em" linebreak="nobreak" data-latex="\\mkern1mu"></mspace>
            <munder data-latex="\\underline{\\mkern-1mu \\GibbsSymbol\\mkern-4mu}">
              <mrow data-latex="\\mkern-1mu \\GibbsSymbol\\mkern-4mu">
                <mspace width="-0.056em" linebreak="nobreak" data-latex="\\mkern-1mu"></mspace>
                <mi data-latex="\\GibbsSymbol">G</mi>
                <mspace width="-0.222em" linebreak="nobreak" data-latex="\\mkern-4mu"></mspace>
              </mrow>
              <mo accent="true">&#x2015;</mo>
            </munder>
            <mspace width="0.222em" linebreak="nobreak" data-latex="\\mkern4mu"></mspace>
          </mrow>
        </mrow>
        <mrow data-latex="\\partial P\\partial \\Nt_i">
          <mi data-latex="\\partial">&#x2202;</mi>
          <mi data-latex="P">P</mi>
          <mi data-latex="\\partial">&#x2202;</mi>
          <msub data-latex="\\Nt_i">
            <mi data-latex="\\Nt">n</mi>
            <mi data-latex="i">i</mi>
          </msub>
        </mrow>
      </mfrac>
      <mo data-mjx-texclass="CLOSE" data-latex="\\right)">)</mo>
    </mrow>
    <mrow data-mjx-texclass="ORD" data-latex="{T,\\Nt_{j\\neq i}}">
      <mi data-latex="T">T</mi>
      <mo data-latex=",">,</mo>
      <msub data-latex="\\Nt_{j\\neq i}">
        <mi data-latex="\\Nt">n</mi>
        <mrow data-mjx-texclass="ORD" data-latex="{j\\neq i}">
          <mi data-latex="j">j</mi>
          <mo data-latex="\\neq">&#x2260;</mo>
          <mi data-latex="i">i</mi>
        </mrow>
      </msub>
    </mrow>
  </msub>
  <mspace width="-0.667em" linebreak="nobreak" data-latex="\\PartialMixSecond*{\\Gt}{P}{\\Nt_i}{T,\\allNsbut{i}}"></mspace>
  <mo data-latex="=">=</mo>
  <msub data-latex="\\left(\\frac{\\partial^2 \\Gt}{\\partial \\Nt_i\\partial P}\\right)_{T,\\Nt_{j\\neq i}}">
    <mrow data-mjx-texclass="INNER" data-latex="\\left(\\frac{\\partial^2 \\Gt}{\\partial \\Nt_i\\partial P}\\right)">
      <mo data-mjx-texclass="OPEN" data-latex="\\left(">(</mo>
      <mfrac data-latex="\\frac{\\partial^2 \\Gt}{\\partial \\Nt_i\\partial P}">
        <mrow data-latex="\\partial^2  \\Gt">
          <msup data-latex="\\partial^2">
            <mi data-latex="\\partial">&#x2202;</mi>
            <mn data-latex="2">2</mn>
          </msup>
          <mrow data-mjx-texclass="ORD" data-latex="\\extensive{\\GibbsSymbol}">
            <mspace width="0.056em" linebreak="nobreak" data-latex="\\mkern1mu"></mspace>
            <munder data-latex="\\underline{\\mkern-1mu \\GibbsSymbol\\mkern-4mu}">
              <mrow data-latex="\\mkern-1mu \\GibbsSymbol\\mkern-4mu">
                <mspace width="-0.056em" linebreak="nobreak" data-latex="\\mkern-1mu"></mspace>
                <mi data-latex="\\GibbsSymbol">G</mi>
                <mspace width="-0.222em" linebreak="nobreak" data-latex="\\mkern-4mu"></mspace>
              </mrow>
              <mo accent="true">&#x2015;</mo>
            </munder>
            <mspace width="0.222em" linebreak="nobreak" data-latex="\\mkern4mu"></mspace>
          </mrow>
        </mrow>
        <mrow data-latex="\\partial \\Nt_i\\partial P">
          <mi data-latex="\\partial">&#x2202;</mi>
          <msub data-latex="\\Nt_i">
            <mi data-latex="\\Nt">n</mi>
            <mi data-latex="i">i</mi>
          </msub>
          <mi data-latex="\\partial">&#x2202;</mi>
          <mi data-latex="P">P</mi>
        </mrow>
      </mfrac>
      <mo data-mjx-texclass="CLOSE" data-latex="\\right)">)</mo>
    </mrow>
    <mrow data-mjx-texclass="ORD" data-latex="{T,\\Nt_{j\\neq i}}">
      <mi data-latex="T">T</mi>
      <mo data-latex=",">,</mo>
      <msub data-latex="\\Nt_{j\\neq i}">
        <mi data-latex="\\Nt">n</mi>
        <mrow data-mjx-texclass="ORD" data-latex="{j\\neq i}">
          <mi data-latex="j">j</mi>
          <mo data-latex="\\neq">&#x2260;</mo>
          <mi data-latex="i">i</mi>
        </mrow>
      </msub>
    </mrow>
  </msub>
  <mspace width="-0.667em" linebreak="nobreak" data-latex="\\PartialMixSecond*{\\Gt}{\\Nt_i}{P}{T,\\allNsbut{i}}"></mspace>
  <mo data-latex="=">=</mo>
  <msub data-latex="\\left(\\frac{\\partial \\Vt}{\\partial \\Nt_i}\\right)_{T,P,\\Nt_{j\\neq i}}">
    <mrow data-mjx-texclass="INNER" data-latex="\\left(\\frac{\\partial \\Vt}{\\partial \\Nt_i}\\right)">
      <mo data-mjx-texclass="OPEN" data-latex="\\left(">(</mo>
      <mfrac data-latex="\\frac{\\partial \\Vt}{\\partial \\Nt_i}">
        <mrow data-latex="\\partial \\Vt">
          <mi data-latex="\\partial">&#x2202;</mi>
          <mrow data-mjx-texclass="ORD" data-latex="\\extensive{\\VolumeSymbol}">
            <mspace width="0.056em" linebreak="nobreak" data-latex="\\mkern1mu"></mspace>
            <munder data-latex="\\underline{\\mkern-1mu \\VolumeSymbol\\mkern-4mu}">
              <mrow data-latex="\\mkern-1mu \\VolumeSymbol\\mkern-4mu">
                <mspace width="-0.056em" linebreak="nobreak" data-latex="\\mkern-1mu"></mspace>
                <mi data-latex="\\VolumeSymbol">V</mi>
                <mspace width="-0.222em" linebreak="nobreak" data-latex="\\mkern-4mu"></mspace>
              </mrow>
              <mo accent="true">&#x2015;</mo>
            </munder>
            <mspace width="0.222em" linebreak="nobreak" data-latex="\\mkern4mu"></mspace>
          </mrow>
        </mrow>
        <mrow data-latex="\\partial \\Nt_i">
          <mi data-latex="\\partial">&#x2202;</mi>
          <msub data-latex="\\Nt_i">
            <mi data-latex="\\Nt">n</mi>
            <mi data-latex="i">i</mi>
          </msub>
        </mrow>
      </mfrac>
      <mo data-mjx-texclass="CLOSE" data-latex="\\right)">)</mo>
    </mrow>
    <mrow data-mjx-texclass="ORD" data-latex="{T,P,\\Nt_{j\\neq i}}">
      <mi data-latex="T">T</mi>
      <mo data-latex=",">,</mo>
      <mi data-latex="P">P</mi>
      <mo data-latex=",">,</mo>
      <msub data-latex="\\Nt_{j\\neq i}">
        <mi data-latex="\\Nt">n</mi>
        <mrow data-mjx-texclass="ORD" data-latex="{j\\neq i}">
          <mi data-latex="j">j</mi>
          <mo data-latex="\\neq">&#x2260;</mo>
          <mi data-latex="i">i</mi>
        </mrow>
      </msub>
    </mrow>
  </msub>
  <mspace width="-0.667em" linebreak="nobreak" data-latex="\\Partial*{\\Vt}{\\Nt_i}{T,P,\\allNsbut{i}}"></mspace>
  <mo data-latex="=">=</mo>
  <mspace width="0.111em" linebreak="nobreak" data-latex="\\mkern2mu"></mspace>
  <mover data-latex="\\overline{\\mkern-2mu{\\VolumeSymbol}_{i}\\mkern-1mu}">
    <mrow data-latex="\\mkern-2mu{\\VolumeSymbol}_{i}\\mkern-1mu">
      <mspace width="-0.111em" linebreak="nobreak" data-latex="\\mkern-2mu"></mspace>
      <msub data-latex="{\\VolumeSymbol}_{i}">
        <mrow data-mjx-texclass="ORD" data-latex="{\\VolumeSymbol}">
          <mi data-latex="\\VolumeSymbol">V</mi>
        </mrow>
        <mrow data-mjx-texclass="ORD" data-latex="{i}">
          <mi data-latex="i">i</mi>
        </mrow>
      </msub>
      <mspace width="-0.056em" linebreak="nobreak" data-latex="\\mkern-1mu"></mspace>
    </mrow>
    <mo accent="true">&#x2015;</mo>
  </mover>
  <mspace width="0.056em" linebreak="nobreak" data-latex="\\partialmolar{\\VolumeSymbol}_i"></mspace>
</math>"
`;

exports[`Thermodynamics Jacobians Jacobian 2 x 2 1`] = `
"<math xmlns="http://www.w3.org/1998/Math/MathML" data-latex="\\Jacobian{K,L}{X,Y} = \\Jacobiandet{K,L}{X,Y}" display="block">
  <mfrac data-latex="\\frac{\\partial(K,L)}{\\partial(X,Y)}">
    <mrow data-latex="\\partial(K,L)">
      <mi data-latex="\\partial">&#x2202;</mi>
      <mo data-latex="(" stretchy="false">(</mo>
      <mi data-latex="K">K</mi>
      <mo data-latex=",">,</mo>
      <mi data-latex="L">L</mi>
      <mo data-latex=")" stretchy="false">)</mo>
    </mrow>
    <mrow data-latex="\\partial(X,Y)">
      <mi data-latex="\\partial">&#x2202;</mi>
      <mo data-latex="(" stretchy="false">(</mo>
      <mi data-latex="X">X</mi>
      <mo data-latex=",">,</mo>
      <mi data-latex="Y">Y</mi>
      <mo data-latex=")" stretchy="false">)</mo>
    </mrow>
  </mfrac>
  <mo data-latex="=">=</mo>
  <mrow data-mjx-texclass="INNER" data-latex="\\begin{vmatrix}\\Partial{K}{X}{Y}&amp;\\Partial{K}{Y}{X}\\\\[1ex]\\Partial{L}{X}{Y}&amp;\\Partial{L}{Y}{X}\\end{vmatrix}">
    <mo data-mjx-texclass="OPEN">|</mo>
    <mtable columnspacing="1em" rowspacing="0.83em 0.4em" data-latex="\\begin{vmatrix}\\Partial{K}{X}{Y}&amp;\\Partial{K}{Y}{X}\\\\[1ex]\\Partial{L}{X}{Y}&amp;\\Partial{L}{Y}{X}\\end{vmatrix}">
      <mtr data-latex="\\left(\\frac{\\partial K}{\\partial X}\\right)_{Y}&amp;\\left(\\frac{\\partial K}{\\partial Y}\\right)_{X}">
        <mtd>
          <msub data-latex="\\left(\\frac{\\partial K}{\\partial X}\\right)_{Y}">
            <mrow data-mjx-texclass="INNER" data-latex="\\left(\\frac{\\partial K}{\\partial X}\\right)">
              <mo data-mjx-texclass="OPEN" data-latex="\\left(">(</mo>
              <mfrac data-latex="\\frac{\\partial K}{\\partial X}">
                <mrow data-latex="\\partial K">
                  <mi data-latex="\\partial">&#x2202;</mi>
                  <mi data-latex="K">K</mi>
                </mrow>
                <mrow data-latex="\\partial X">
                  <mi data-latex="\\partial">&#x2202;</mi>
                  <mi data-latex="X">X</mi>
                </mrow>
              </mfrac>
              <mo data-mjx-texclass="CLOSE" data-latex="\\right)">)</mo>
            </mrow>
            <mrow data-mjx-texclass="ORD" data-latex="{Y}">
              <mi data-latex="Y">Y</mi>
            </mrow>
          </msub>
        </mtd>
        <mtd>
          <msub data-latex="\\left(\\frac{\\partial K}{\\partial Y}\\right)_{X}">
            <mrow data-mjx-texclass="INNER" data-latex="\\left(\\frac{\\partial K}{\\partial Y}\\right)">
              <mo data-mjx-texclass="OPEN" data-latex="\\left(">(</mo>
              <mfrac data-latex="\\frac{\\partial K}{\\partial Y}">
                <mrow data-latex="\\partial K">
                  <mi data-latex="\\partial">&#x2202;</mi>
                  <mi data-latex="K">K</mi>
                </mrow>
                <mrow data-latex="\\partial Y">
                  <mi data-latex="\\partial">&#x2202;</mi>
                  <mi data-latex="Y">Y</mi>
                </mrow>
              </mfrac>
              <mo data-mjx-texclass="CLOSE" data-latex="\\right)">)</mo>
            </mrow>
            <mrow data-mjx-texclass="ORD" data-latex="{X}">
              <mi data-latex="X">X</mi>
            </mrow>
          </msub>
        </mtd>
      </mtr>
      <mtr data-latex="\\left(\\frac{\\partial L}{\\partial X}\\right)_{Y}&amp;\\left(\\frac{\\partial L}{\\partial Y}\\right)_{X}">
        <mtd>
          <msub data-latex="\\left(\\frac{\\partial L}{\\partial X}\\right)_{Y}">
            <mrow data-mjx-texclass="INNER" data-latex="\\left(\\frac{\\partial L}{\\partial X}\\right)">
              <mo data-mjx-texclass="OPEN" data-latex="\\left(">(</mo>
              <mfrac data-latex="\\frac{\\partial L}{\\partial X}">
                <mrow data-latex="\\partial L">
                  <mi data-latex="\\partial">&#x2202;</mi>
                  <mi data-latex="L">L</mi>
                </mrow>
                <mrow data-latex="\\partial X">
                  <mi data-latex="\\partial">&#x2202;</mi>
                  <mi data-latex="X">X</mi>
                </mrow>
              </mfrac>
              <mo data-mjx-texclass="CLOSE" data-latex="\\right)">)</mo>
            </mrow>
            <mrow data-mjx-texclass="ORD" data-latex="{Y}">
              <mi data-latex="Y">Y</mi>
            </mrow>
          </msub>
        </mtd>
        <mtd>
          <msub data-latex="\\left(\\frac{\\partial L}{\\partial Y}\\right)_{X}">
            <mrow data-mjx-texclass="INNER" data-latex="\\left(\\frac{\\partial L}{\\partial Y}\\right)">
              <mo data-mjx-texclass="OPEN" data-latex="\\left(">(</mo>
              <mfrac data-latex="\\frac{\\partial L}{\\partial Y}">
                <mrow data-latex="\\partial L">
                  <mi data-latex="\\partial">&#x2202;</mi>
                  <mi data-latex="L">L</mi>
                </mrow>
                <mrow data-latex="\\partial Y">
                  <mi data-latex="\\partial">&#x2202;</mi>
                  <mi data-latex="Y">Y</mi>
                </mrow>
              </mfrac>
              <mo data-mjx-texclass="CLOSE" data-latex="\\right)">)</mo>
            </mrow>
            <mrow data-mjx-texclass="ORD" data-latex="{X}">
              <mi data-latex="X">X</mi>
            </mrow>
          </msub>
        </mtd>
      </mtr>
    </mtable>
    <mo data-mjx-texclass="CLOSE">|</mo>
  </mrow>
</math>"
`;

