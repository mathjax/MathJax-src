  </msub>
</math>"
`;

exports[`Thermodynamics enironments thermolongpm 1`] = `
"<math xmlns="http://www.w3.org/1998/Math/MathML" data-latex="
      \\begin{thermoshortpm}
        \\Spm_i^\\IGM + \\SRpm_i
        \\begin{thermolongpm}
          = \\Spm_i^\\IGM + \\SRpm_i
        \\end{thermolongpm}
      \\end{thermoshortpm}
    " display="block">
  <mspace width="0.111em" linebreak="nobreak" data-latex="\\mkern2mu"></mspace>
  <mover data-latex="\\overline{\\mkern-2mu{\\EntropySymbol\\mkern-1mu}}">
    <mrow data-latex="\\mkern-2mu{\\EntropySymbol\\mkern-1mu}">
      <mspace width="-0.111em" linebreak="nobreak" data-latex="\\mkern-2mu"></mspace>
