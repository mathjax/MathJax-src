  <msub data-latex="\\left(\\frac{\\partial \\cVt}{\\partial \\Nt_i}\\right)_{T,P,\\Nt_{j\\neq i}}">
    <mrow data-mjx-texclass="INNER" data-latex="\\left(\\frac{\\partial \\cVt}{\\partial \\Nt_i}\\right)">
      <mo data-mjx-texclass="OPEN" data-latex="\\left(">(</mo>
      <mfrac data-latex="\\frac{\\partial \\cVt}{\\partial \\Nt_i}">
        <mrow data-latex="\\partial \\cVt">
          <mi data-latex="\\partial">&#x2202;</mi>
          <msub data-latex="{\\mkern1mu\\underline{\\mkern-1mu \\heatcapacitysymbol\\mkern-4mu}\\mkern4mu}_{\\VolumeSymbol}">
            <mrow data-mjx-texclass="ORD" data-latex="{\\mkern1mu\\underline{\\mkern-1mu \\heatcapacitysymbol\\mkern-4mu}\\mkern4mu}">
              <mspace width="0.056em" linebreak="nobreak" data-latex="\\mkern1mu"></mspace>
              <munder data-latex="\\underline{\\mkern-1mu \\heatcapacitysymbol\\mkern-4mu}">
