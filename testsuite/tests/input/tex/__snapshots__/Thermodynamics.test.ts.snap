      <mo data-latex=",">,</mo>
      <msub data-latex="\\Nt_{j\\neq i}">
        <mi data-latex="\\Nt">n</mi>
        <mrow data-mjx-texclass="ORD" data-latex="{j\\neq i}">
          <mi data-latex="j">j</mi>
          <mo data-latex="\\neq">&#x2260;</mo>
          <mi data-latex="i">i</mi>
        </mrow>
      </msub>
    </mrow>
  </msub>
  <mspace width="-0.667em" linebreak="nobreak" data-latex="\\Partial*{\\cVt}{\\Nt_i}{T,P,\\allNsbut{i}}"></mspace>
  <mo data-latex="=">=</mo>
  <mfrac data-latex="\\frac{\\partial}{\\partial\\Nt_i}">
