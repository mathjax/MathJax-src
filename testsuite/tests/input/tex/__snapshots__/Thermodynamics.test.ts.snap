      <mo data-mjx-texclass="CLOSE" data-latex="\\right)">)</mo>
    </mrow>
    <mrow data-mjx-texclass="ORD" data-latex="{T,P,\\Nt_{m\\neq1}}">
      <mi data-latex="T">T</mi>
      <mo data-latex=",">,</mo>
      <mi data-latex="P">P</mi>
      <mo data-latex=",">,</mo>
      <msub data-latex="\\Nt_{m\\neq1}">
        <mi data-latex="\\Nt">n</mi>
        <mrow data-mjx-texclass="ORD" data-latex="{m\\neq1}">
          <mi data-latex="m">m</mi>
          <mo data-latex="\\neq">&#x2260;</mo>
          <mn data-latex="1">1</mn>
        </mrow>
      </msub>
    </mrow>
  </msub>
  <mo data-latex="=">=</mo>
  <mspace width="0.111em" linebreak="nobreak" data-latex="\\mkern2mu"></mspace>
  <mover data-latex="\\overline{\\mkern-2mu{\\EnthalpySymbol}_{1}\\mkern-1mu}">
    <mrow data-latex="\\mkern-2mu{\\EnthalpySymbol}_{1}\\mkern-1mu">
      <mspace width="-0.111em" linebreak="nobreak" data-latex="\\mkern-2mu"></mspace>
      <msub data-latex="{\\EnthalpySymbol}_{1}">
        <mrow data-mjx-texclass="ORD" data-latex="{\\EnthalpySymbol}">
          <mi data-latex="\\EnthalpySymbol">H</mi>
        </mrow>
        <mrow data-mjx-texclass="ORD" data-latex="{1}">
          <mn data-latex="1">1</mn>
        </mrow>
      </msub>
      <mspace width="-0.056em" linebreak="nobreak" data-latex="\\mkern-1mu"></mspace>
    </mrow>
    <mo accent="true">&#x2015;</mo>
