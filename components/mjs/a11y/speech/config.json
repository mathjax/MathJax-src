{
  "build": {
    "component": "a11y/speech",
    "targets": ["a11y/speech.ts", "a11y/speech"],
    "exclude": [
      "a11y/speech/SpeechMenu.ts",
      "a11y/speech/strings.ts"
    ]
  },
  "copy": {
    "to": "[bundle]/a11y/speech",
    "from": "[ts]/a11y/speech",
    "copy": ["__locales__"],
    "excludes": ["__locales__/Component.ts", "__locales__/preload.cts"]
  },
  "webpack": {
    "name": "a11y/speech",
    "libs": [
      "components/src/a11y/semantic-enrich/lib",
      "components/src/a11y/sre/lib",
      "components/src/input/mml/lib",
      "components/src/core/lib"
    ]
  }
}
