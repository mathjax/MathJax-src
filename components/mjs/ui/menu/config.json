{
  "build": {
    "component": "ui/menu",
    "targets": [
      "ui/menu",
      "a11y/speech/SpeechMenu.ts",
      "a11y/semantic-enrich/strings.ts",
      "a11y/speech/strings.ts",
      "ui/menu/__locales__",
      "a11y/aria/__locales__"
    ],
    "excludeSubdirs": true
  },
  "copy": [
    {
      "to": "[bundle]/ui/menu",
      "from": "[ts]/ui/menu",
      "copy": ["__locales__"],
      "excludes": ["__locales__/Component.ts", "__locales__/preload.cts"]
    },
    {
      "to": "[bundle]/a11y/aria",
      "from": "[ts]/a11y/aria",
      "copy": ["__locales__"],
      "excludes": ["__locales__/Component.ts", "__locales__/preload.cts"]
    }
  ],
  "webpack": {
    "name": "ui/menu",
    "libs": [
      "components/src/core/lib",
      "components/src/a11y/sre/lib",
      "node_modules/mj-context-menu/js"
    ]
  }
}
