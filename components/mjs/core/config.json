{
  "build": {
    "component": "core",
    "targets": [
      "mathjax.ts",
      "core", "util", "handlers",
      "ui/dialog/DraggableDialog.ts",
      "ui/dialog/InfoDialog.ts",
      "adaptors/HTMLAdaptor.ts",
      "adaptors/browserAdaptor.ts",
      "components/global.ts"
    ],
    "exclude": [
      "core/MmlTree/JsonMmlVisitor.ts",
      "core/MmlTree/LegacyMmlVisitor.ts",
      "core/MmlTree/TestMmlVisitor.ts",
      "util/asyncLoad",
      "util/entities"
    ]
  },
  "copy": [
    {
      "to": "[bundle]/core",
      "from": "[ts]/core",
      "copy": ["__locales__"],
      "excludes": ["__locales__/Component.ts", "__locales__/preload.cts"]
    }
  ],
  "webpack": {
    "name": "core"
  }
}
